# Nirvana project skeleton

# Logs and registries (per-machine)
.harness-logs/
.maestro-logs/
.projects-outputs/

# Run deliverables (visíveis em ./outputs/<run_id>/). Tipicamente não vão pro
# git; remova esta linha se quiser versionar as entregas.
outputs/
.squads-registry.json
.businesses-registry.json

# Symlinked agent skill dirs (recreated by `bun init-project.ts --link`)
.claude/skills
.continue/skills
.windsurf/skills
.goose/skills
.kilocode/skills
.roo/skills
.openhands/skills
.qwen/skills
.aider-desk/skills

# Don't ignore the canonical .agents/skills (it's the source of truth)
!.agents/skills

# Local secrets — use .env.local for these, never commit
.env.local
.env.*.local

# OS noise
.DS_Store
Thumbs.db

# Monorepo — node_modules, build artifacts, turbo cache
node_modules/
dist/
.turbo/
build/
.next/
out/
storybook-static/

# Environment secrets — NEVER commit .env
.env
.env.*
!.env.example
# Exceção CIRÚRGICA (lane DEPLOY-PREVIEW): config web pública do Firebase do
# painel — não é segredo (vai para qualquer navegador). SÓ este path (na
# raiz porque o vite.config.ts do painel fixa envDir na raiz do monorepo).
!/.env.leela-hub
# Idem: flag de ativação deliberada de produção do Asaas (sem segredos)
!/functions/.env.leela-hub
# Idem (lane LANDING-PREVIEW): config web pública + URL canônica da landing.
# Fica no diretório do app porque o Next lê env do próprio app, não da raiz.
!/apps/landing/.env.leela-hub
# Idem (lane MOCK-CAMPECHE): modo de build do painel apontado ao EMULADOR.
# Não tem credencial nenhuma — só `VITE_USE_EMULATOR=true` e portas de
# loopback. Commitado para o comando de 1 linha do dono sobreviver a reboot.
!/.env.mock-emulador
# Valores locais dos secrets declarados (Functions Emulator) — NUNCA commitar
.secret.local

# Runtime do mock local (logs + pids do scripts/mock-campeche.sh)
.mock-campeche/
# Build do painel em modo emulador (outDir próprio para não substituir o
# `dist/` de produção que a :4601 serve)
dist-mock-campeche/

# Artefato de deploy das Functions (gerado por bundle-deploy.mjs)
functions-deploy/

# Sondagem descartável do bundle das Functions (cópia de functions/src). A lane
# PIXREAL-FIX deixou uma sem rastreio e ela quebrou o `tsc` do pacote e fez o
# vitest coletar uma CÓPIA do teste da guarda de segredos — vermelho que não
# vinha do código de verdade. A pasta já foi apagada; a linha fica para que um
# `git add -A` distraído nunca a versione (lane DEPLOY-EMAIL).
functions/src/__probe__/

# Cache/codegen do firebase-tools (inclui o backend SSR gerado pelo web
# frameworks em .firebase/<site>/functions) — artefato de build, nunca fonte
.firebase/

# Backup transitório do package.json durante o deploy da landing
# (apps/landing/scripts/deploy-leela-hub.mjs restaura no finally)
*.deploybak

# Snapshot local do Emulator Suite (emulators:export / --import)
.emulator-data/

# pnpm
.pnpm-store/

# TypeScript
*.tsbuildinfo

# Junções ao pool global Nirvana (NUNCA commitar)
.nirvana/squads/
.nirvana/businesses/
.nirvana/mind-clones/

# Config do Obsidian (local)
.obsidian/

# Sobras de quem roda o emulador local (preview.sh / mock-campeche.sh).
# Nascem na raiz do worktree, ninguém as rastreia e elas apareciam soltas no
# `git status` de toda lane que sobe o mock — o tipo de ruído que entra num
# `git add -A` distraído. `functions/lib/` é saída do `tsc` das Functions.
firebase-debug.log
firestore-debug.log
ui-debug.log
pubsub-debug.log
database-debug.log
functions/lib/

# Faxina local (14/10/2026): estado de máquina que nunca é fonte.
# Worktrees de agentes — cada um é um checkout inteiro (com node_modules) de um
# ramo que já está no origin; o git os gerencia por `git worktree`.
.claude/worktrees/
# Logs do harness por máquina (o .harness-logs/ da raiz já é ignorado)
.nirvana/logs/
# Cache e logs locais do Expo (dev server do apps/mobile)
.expo/
