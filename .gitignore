# Nirvana project skeleton

# Logs and registries (per-machine)
.harness-logs/
.maestro-logs/
.projects-outputs/

# Run deliverables (visíveis em ./outputs/<run_id>/). Tipicamente não vão pro
# git; remova esta linha se quiser versionar as entregas.
outputs/
.squads-registry.json
.businesses-registry.json

# Symlinked agent skill dirs (recreated by `bun init-project.ts --link`)
.claude/skills
.continue/skills
.windsurf/skills
.goose/skills
.kilocode/skills
.roo/skills
.openhands/skills
.qwen/skills
.aider-desk/skills

# Don't ignore the canonical .agents/skills (it's the source of truth)
!.agents/skills

# Local secrets — use .env.local for these, never commit
.env.local
.env.*.local

# OS noise
.DS_Store
Thumbs.db

# Monorepo — node_modules, build artifacts, turbo cache
node_modules/
dist/
.turbo/
build/
.next/
out/
storybook-static/

# Environment secrets — NEVER commit .env
.env
.env.*
!.env.example
# Exceção CIRÚRGICA (lane DEPLOY-PREVIEW): config web pública do Firebase do
# painel — não é segredo (vai para qualquer navegador). SÓ este path.
!/apps/painel/.env.leela-hub

# Snapshot local do Emulator Suite (emulators:export / --import)
.emulator-data/

# pnpm
.pnpm-store/

# TypeScript
*.tsbuildinfo

# Junções ao pool global Nirvana (NUNCA commitar)
.nirvana/squads/
.nirvana/businesses/
.nirvana/mind-clones/

# Config do Obsidian (local)
.obsidian/
