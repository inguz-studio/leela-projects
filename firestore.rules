// firestore.rules — LEELA · Onda 0
//
// Deny-by-default: toda coleção é bloqueada por padrão.
// Isolamento multi-tenant completo em S1600-T3 (ADR-009).
// Hardening pós-review S1600 (fix write-takeover cross-tenant):
//   - create/update/delete separados em TODA coleção tenant-scoped;
//   - update valida o DONO ATUAL (resource.data.tenantId) e exige
//     tenantId IMUTÁVEL (request.resource.data.tenantId == resource.data.tenantId);
//   - delete valida o dono atual;
//   - writes de cliente exigem papel de escrita (tenant_owner/tenant_staff),
//     nunca promoter/athlete (RBAC intra-tenant mínimo).
//
// Partição de coleções (ADR-009 §Estratégia de partição):
//   TENANT-SCOPED : eventos, clubes, comunicados, parcerias,
//                   programaAfiliacao, pagamentos, equipe, promotores, subscriptions
//                   (inscritos vive APENAS em eventos/{id}/inscritos — E03;
//                   a top-level /inscritos foi aposentada no review Onda1 #4)
//   GLOBAL        : atletas, catalogoAcoes, config/system
//   PLATAFORMA    : tenants/{id}, tenants/{id}/commercialTerms, platform/…
//
// Helpers de autorização reutilizados em todas as rules:
//   isSignedIn()              — usuário autenticado
//   isPlatformAdmin()         — role == 'platform_admin' no custom claim
//   isTenantMember(tenantId)  — tenantId do claim bate com o documento (leitura)
//   isTenantWriter(tenantId)  — membro com papel de escrita (owner/staff)
//   isTenantOwner(tenantId)   — apenas tenant_owner (writes mais sensíveis)
//   tenantAtivo(tenantId)     — bloqueia escrita em tenant suspenso (RN-402)

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers de autorização (ADR-009) ───────────────────────────────────

    /** Usuário autenticado */
    function isSignedIn() {
      return request.auth != null;
    }

    /** platform_admin: acesso cross-tenant (leitura macro + configuração) */
    function isPlatformAdmin() {
      return isSignedIn() && request.auth.token.role == 'platform_admin';
    }

    /**
     * Membro do tenant: claim.tenantId bate com o tenantId do recurso.
     * Usado para LEITURA em coleção tenant-scoped (RN-400).
     * Qualquer papel com claim de tenant (owner/staff/promoter) lê o próprio tenant.
     */
    function isTenantMember(tenantId) {
      return isSignedIn() && request.auth.token.tenantId == tenantId;
    }

    /**
     * Papel de ESCRITA dentro do tenant: tenant_owner ou tenant_staff.
     * promoter é membro (lê), mas NÃO escreve dados de domínio pelo cliente.
     * Nota de dívida: o épico S1600 exige isolamento ENTRE tenants (RN-400);
     * o RBAC intra-tenant fino (por coleção/campo) adensa em stories futuras.
     */
    function isTenantWriter(tenantId) {
      return isTenantMember(tenantId)
        && (request.auth.token.role == 'tenant_owner'
            || request.auth.token.role == 'tenant_staff');
    }

    /** Apenas o tenant_owner — writes mais sensíveis (ex.: equipe). */
    function isTenantOwner(tenantId) {
      return isTenantMember(tenantId)
        && request.auth.token.role == 'tenant_owner';
    }

    /**
     * Tenant ativo: bloqueia ESCRITA quando o tenant está suspenso (RN-402).
     * Só nega writes; reads de dados existentes permanecem (leitura preservada).
     * Requer leitura do doc tenants/{tenantId} — usa get().
     */
    function tenantAtivo(tenantId) {
      return get(/databases/$(database)/documents/tenants/$(tenantId)).data.status == 'ativo';
    }

    /** Status de tenant válido (RN-402) — valida enum na escrita de tenants. */
    function isValidTenantStatus(status) {
      return status in ['pending', 'ativo', 'suspenso'];
    }

    // ── `tenants/{tenantId}` — coleção de plataforma ──────────────────────
    //
    // Leitura: membro do tenant (claim.tenantId bate) OU platform_admin.
    // Escrita: APENAS platform_admin (ou Function/Admin SDK via bypass de Rules).
    // Transições de status passam pela Function `transitionTenant`
    // (valida canTransition — RN-402); a rule ao menos trava o enum.
    //
    // RN-400: dado de um tenant nunca é legível por outro tenant.
    // RN-401: papel vem do custom claim, não do cliente.
    // RN-404: termos comerciais exclusivo do platform_admin.
    match /tenants/{tenantId} {
      allow read: if isTenantMember(tenantId) || isPlatformAdmin();
      allow create, update: if isPlatformAdmin()
                            && isValidTenantStatus(request.resource.data.status);
      allow delete: if isPlatformAdmin();

      // `commercialTerms/{doc}` — termos por tenant (E16 · S1602-T1)
      //
      // Leitura: membro do tenant (read-only) ou platform_admin.
      // Escrita: APENAS platform_admin (RN-404) — defesa em profundidade:
      // a Rule revalida ranges (RN-405: saasMonthlyFee 0 é VÁLIDO) e o
      // versionamento que o core/api-client já validam no cliente.
      //
      // Versionamento (fonte de auditoria econômica — RN-406):
      //   - `current`: create exige versao == 1; update exige bump exato
      //     (versao == anterior + 1); delete NEGADO (termo vigente nunca some);
      //   - snapshots `v{n}`: create-only com nome coerente à versao
      //     (histórico imutável — update/delete negados até para admin).
      match /commercialTerms/{doc} {

        /** Shape completo dos termos + ranges (RN-404/405/410). */
        function termsShapeValido() {
          return request.resource.data.keys().hasAll([
              'platformFeePct', 'installmentRules', 'anticipation',
              'communityMonthlyEnabled', 'saasMonthlyFee', 'versao',
              'atualizadoPor', 'atualizadoEm'
            ])
            && request.resource.data.platformFeePct is number
            && request.resource.data.platformFeePct >= 0
            && request.resource.data.platformFeePct <= 100
            && request.resource.data.saasMonthlyFee is number
            && request.resource.data.saasMonthlyFee >= 0
            && request.resource.data.installmentRules is map
            && request.resource.data.installmentRules.maxParcelas is int
            && request.resource.data.installmentRules.maxParcelas >= 1
            && request.resource.data.installmentRules.jurosAoMes is number
            && request.resource.data.installmentRules.jurosAoMes >= 0
            && request.resource.data.installmentRules.parcelaMinima is number
            && request.resource.data.installmentRules.parcelaMinima >= 0
            && request.resource.data.anticipation is map
            && request.resource.data.anticipation.disponivel is bool
            && (!('custoPct' in request.resource.data.anticipation)
                || (request.resource.data.anticipation.custoPct is number
                    && request.resource.data.anticipation.custoPct >= 0
                    && request.resource.data.anticipation.custoPct <= 100))
            && request.resource.data.communityMonthlyEnabled is bool
            && request.resource.data.versao is int
            && request.resource.data.versao >= 1
            && request.resource.data.atualizadoPor is string;
        }

        allow read: if isTenantMember(tenantId) || isPlatformAdmin();
        // create: `current` nasce na versao 1; snapshot exige nome coerente
        allow create: if isPlatformAdmin()
                      && termsShapeValido()
                      && (doc == 'current'
                            ? request.resource.data.versao == 1
                            : doc == 'v' + string(request.resource.data.versao));
        // update: SÓ `current`, com bump exato (snapshots são imutáveis)
        allow update: if isPlatformAdmin()
                      && doc == 'current'
                      && termsShapeValido()
                      && request.resource.data.versao == resource.data.versao + 1;
        // delete: NUNCA — termo vigente não some; histórico é preservado
        allow delete: if false;
      }

      // `subscriptions/{subId}` — mensalidades da comunidade (S1603)
      // Status escrito só por Function; leitura pelo atleta dono e pelo tenant.
      match /subscriptions/{subId} {
        allow read: if isTenantMember(tenantId)
                    || isPlatformAdmin()
                    || (isSignedIn() && request.auth.uid == resource.data.atletaId);
        // Cliente não escreve status/proximaCobranca — só Function (Admin SDK)
        allow write: if false;
      }
    }

    // ── `platform/{doc}` — dados macro da plataforma ──────────────────────
    // Leitura: apenas platform_admin.
    // Escrita: apenas Function/Admin SDK (client nunca escreve).
    match /platform/{doc=**} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }

    // ── Coleções tenant-scoped ────────────────────────────────────────────
    //
    // Toda coleção de domínio carrega `tenantId` (ADR-009).
    // Padrão seguro (fix write-takeover):
    //   read   — membro do tenant DONO ATUAL (resource) ou platform_admin;
    //   create — papel de escrita no tenant carimbado + tenant ativo (RN-402);
    //   update — papel de escrita no tenant DONO ATUAL + tenantId imutável
    //            + tenant ativo;
    //   delete — papel de escrita no tenant DONO ATUAL + tenant ativo.
    //
    // Coleções: eventos, clubes, comunicados, parcerias,
    //           programaAfiliacao, pagamentos, equipe, promotores, subscriptions
    // (inscritos: só a subcoleção eventos/{id}/inscritos — review Onda1 #4)

    // `eventos/{eventoId}` — Operação do Evento (E03 · S200-T1). docId = slug.
    //
    // Além do padrão tenant-scoped:
    //   - agregados ∑ (qtdInscritos, receitaConfirmada) são de escrita
    //     EXCLUSIVA da Cloud Function (Admin SDK): create exige 0/ausente,
    //     update não pode tocá-los;
    //   - status sempre dentro do enum {rascunho,publicado,ao_vivo,encerrado}.
    match /eventos/{eventoId} {

      /** Agregados ∑ nascem zerados (ou ausentes) — cliente nunca inventa contagem. */
      function eventoAgregadosZerados() {
        return request.resource.data.get('qtdInscritos', 0) == 0
          && request.resource.data.get('receitaConfirmada', 0) == 0;
      }

      /** Update de cliente não toca campos ∑ (só a Function os mantém). */
      function eventoAgregadosIntocados() {
        return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['qtdInscritos', 'receitaConfirmada']);
      }

      /** Status dentro do ciclo de vida canônico do evento. */
      function statusEventoValido() {
        return request.resource.data.status in ['rascunho', 'publicado', 'ao_vivo', 'encerrado'];
      }

      /**
       * RN-200 (S201-T3): após a 1ª venda (∑ qtdInscritos > 0) o cliente não
       * toca `percursos` — o preço faz parte do percurso. Sem venda, edita.
       */
      function percursosEditaveis() {
        return resource.data.get('qtdInscritos', 0) == 0
          || !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['percursos']);
      }

      // TODO(E04/compra): quando o fluxo de compra entrar, abrir leitura
      // PÚBLICA apenas de eventos com status 'publicado' (athlete/anônimo).
      // NÃO abrir antes — deny-by-default até a story do checkout, com teste.
      allow read: if isTenantMember(resource.data.tenantId) || isPlatformAdmin();
      allow create: if (isTenantWriter(request.resource.data.tenantId)
                        && tenantAtivo(request.resource.data.tenantId)
                        && eventoAgregadosZerados()
                        && statusEventoValido())
                    || isPlatformAdmin();
      allow update: if (isTenantWriter(resource.data.tenantId)
                        && request.resource.data.tenantId == resource.data.tenantId
                        && tenantAtivo(resource.data.tenantId)
                        && eventoAgregadosIntocados()
                        && statusEventoValido()
                        && percursosEditaveis())
                    || isPlatformAdmin();
      allow delete: if (isTenantWriter(resource.data.tenantId)
                        && tenantAtivo(resource.data.tenantId))
                    || isPlatformAdmin();

      /** tenantId do evento pai — subcoleções carregam tenantId coerente (ADR-009). */
      function tenantDoEventoPai() {
        return get(/databases/$(database)/documents/eventos/$(eventoId)).data.tenantId;
      }

      /** ∑ qtdInscritos do evento pai > 0 ⇒ evento tem venda (RN-200). */
      function eventoPaiTemVenda() {
        return get(/databases/$(database)/documents/eventos/$(eventoId))
          .data.get('qtdInscritos', 0) > 0;
      }

      // `inscritos/{inscritoId}` — join Atleta↔Evento (E03 · S203-T1).
      //
      // Shape (RN-202/203/204): kit e status dentro dos enums; chipNumero
      // string|null (null até a entrega). Carimbos de operação
      // (kitEntregueEm/checkinEm/qrToken/ingressoEmitidoEm) são de escrita
      // EXCLUSIVA de Function (RN-205/221/222) — cliente nunca escreve.
      // TODO(E04/E12): atleta dono lê a própria inscrição só na story do
      // checkout, com teste (mesmo gate do TODO de leitura pública acima).
      match /inscritos/{inscritoId} {

        /** Kit dentro do enum canônico (RN-202; "kit", nunca "tier" — RN-216). */
        function kitInscritoValido() {
          return request.resource.data.kit in ['kit_ouro', 'kit_prata', 'kit_basico', 'sem_kit'];
        }

        /** Status dentro do enum canônico (RN-204). */
        function statusInscritoValido() {
          return request.resource.data.status in ['confirmado', 'pendente', 'cancelado'];
        }

        /**
         * chipNumero no CREATE: ausente ou null — o vínculo é escrita
         * EXCLUSIVA da Function `vincularChip` (RN-203/206; S204-T2). Sem
         * isso a detecção de conflito seria contornável por escrita direta.
         */
        function chipNuloNoCreate() {
          return !('chipNumero' in request.resource.data)
            || request.resource.data.chipNumero == null;
        }

        /** Cliente não CRIA doc já carimbado com campos de Function. */
        function semCamposDeFunctionInscrito() {
          return !request.resource.data.keys().hasAny(
            ['kitEntregueEm', 'checkinEm', 'qrToken', 'ingressoEmitidoEm']
          );
        }

        /**
         * Update de cliente não TOCA campos de Function (RN-205/206/221/222).
         * `chipNumero` incluso (S204-T2): nem para setar, nem para limpar.
         */
        function camposDeFunctionIntocados() {
          return !request.resource.data.diff(resource.data).affectedKeys().hasAny(
            ['kitEntregueEm', 'checkinEm', 'qrToken', 'ingressoEmitidoEm', 'chipNumero']
          );
        }

        allow read: if isPlatformAdmin()
                    || isTenantMember(tenantDoEventoPai());
        allow create: if (isTenantWriter(request.resource.data.tenantId)
                          && request.resource.data.tenantId == tenantDoEventoPai()
                          && tenantAtivo(request.resource.data.tenantId)
                          && kitInscritoValido()
                          && statusInscritoValido()
                          && chipNuloNoCreate()
                          && semCamposDeFunctionInscrito())
                      || isPlatformAdmin();
        allow update: if (isTenantWriter(resource.data.tenantId)
                          && request.resource.data.tenantId == resource.data.tenantId
                          && tenantAtivo(resource.data.tenantId)
                          && kitInscritoValido()
                          && statusInscritoValido()
                          && camposDeFunctionIntocados())
                      || isPlatformAdmin();
        allow delete: if (isTenantWriter(resource.data.tenantId)
                          && tenantAtivo(resource.data.tenantId))
                      || isPlatformAdmin();
      }

      // `kits/{kitId}` — kits do evento (E03 · S205-T1).
      //
      // RN-210: 0..N kits por evento. RN-211: "Sem kit" é kit válido e o
      // preço ACEITA NEGATIVO (desconto) — shape exige number, sem piso.
      // RN-216: o campo/conceito é "kit" — "tier" não existe no produto.
      match /kits/{kitId} {

        /** Shape mínimo do kit (nome não-vazio; preco number, negativo ok). */
        function shapeKitValido() {
          return request.resource.data.nome is string
            && request.resource.data.nome.size() > 0
            && request.resource.data.preco is number
            && request.resource.data.capacidade is number
            && request.resource.data.modalidades is list;
        }

        /**
         * RN-200 (S201-T3): evento COM venda ⇒ cliente não muda `preco` do
         * kit. Outros campos seguem editáveis; sem venda, preço livre
         * (inclusive mais negativo no "Sem kit" — RN-211 preservada).
         */
        function precoEditavel() {
          return !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['preco'])
            || !eventoPaiTemVenda();
        }

        allow read: if isPlatformAdmin()
                    || isTenantMember(tenantDoEventoPai());
        allow create: if (isTenantWriter(request.resource.data.tenantId)
                          && request.resource.data.tenantId == tenantDoEventoPai()
                          && tenantAtivo(request.resource.data.tenantId)
                          && shapeKitValido())
                      || isPlatformAdmin();
        allow update: if (isTenantWriter(resource.data.tenantId)
                          && request.resource.data.tenantId == resource.data.tenantId
                          && tenantAtivo(resource.data.tenantId)
                          && shapeKitValido()
                          && precoEditavel())
                      || isPlatformAdmin();
        allow delete: if (isTenantWriter(resource.data.tenantId)
                          && tenantAtivo(resource.data.tenantId))
                      || isPlatformAdmin();
      }

      match /{subcol}/{docId} {
        allow read: if isPlatformAdmin()
                    || isTenantMember(get(/databases/$(database)/documents/eventos/$(eventoId)).data.tenantId);
        allow write: if isPlatformAdmin();
      }
    }

    // `clubes/{clubeId}` — módulo Clubs (E05 · S101-T1). docId = slug.
    //
    // Além do padrão tenant-scoped:
    //   - leitura PÚBLICA quando visibilidade in ['publica','indexavel']
    //     (RN-140 — página pública/SEO); clube 'privada' segue só tenant;
    //   - agregados ∑ (qtdMembrosAtivos, qtdDesafiosAtivos) são de escrita
    //     EXCLUSIVA da Cloud Function (Admin SDK): create exige 0/ausente,
    //     update não pode tocá-los (S101-T1/S103-T1).
    match /clubes/{clubeId} {

      /** Agregados ∑ nascem zerados (ou ausentes) — cliente nunca inventa contagem. */
      function clubeAgregadosZerados() {
        return request.resource.data.get('qtdMembrosAtivos', 0) == 0
          && request.resource.data.get('qtdDesafiosAtivos', 0) == 0;
      }

      /** Update de cliente não toca campos ∑ (só a Function os mantém). */
      function clubeAgregadosIntocados() {
        return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['qtdMembrosAtivos', 'qtdDesafiosAtivos']);
      }

      allow read: if isTenantMember(resource.data.tenantId)
                  || isPlatformAdmin()
                  || resource.data.visibilidade in ['publica', 'indexavel'];
      allow create: if (isTenantWriter(request.resource.data.tenantId)
                        && tenantAtivo(request.resource.data.tenantId)
                        && clubeAgregadosZerados())
                    || isPlatformAdmin();
      allow update: if (isTenantWriter(resource.data.tenantId)
                        && request.resource.data.tenantId == resource.data.tenantId
                        && tenantAtivo(resource.data.tenantId)
                        && clubeAgregadosIntocados())
                    || isPlatformAdmin();
      allow delete: if (isTenantWriter(resource.data.tenantId)
                        && tenantAtivo(resource.data.tenantId))
                    || isPlatformAdmin();

      /** tenantId do clube pai — subcoleções carregam tenantId coerente (ADR-009). */
      function tenantDoClubePai() {
        return get(/databases/$(database)/documents/clubes/$(clubeId)).data.tenantId;
      }

      // `membros/{membroId}` — join Atleta↔Clube (E05 · S103-T1).
      //
      // RN-102: `status` é DERIVADO por data — escrita EXCLUSIVA da Cloud
      // Function (onMembroWrite + cron recalcularStatusMembros). O mesmo vale
      // para `ultimaAtividadeEm` (trilha de atividade). Papel de escrita do
      // tenant gerencia membros (remover/transferir — S103-T2), mas nunca
      // inventa status nem atividade. Membros NUNCA são públicos, mesmo em
      // clube com visibilidade 'publica' — leitura só do tenant dono.
      match /membros/{membroId} {

        /** Papel dentro do enum canônico (RN-103). */
        function papelMembroValido() {
          return request.resource.data.papel in ['owner', 'admin', 'membro'];
        }

        /** Via de entrada dentro do enum canônico. */
        function entradaViaValida() {
          return request.resource.data.entrouVia in ['codigo', 'convite', 'link'];
        }

        /** Cliente não CRIA doc já carimbado com campos de Function (RN-102). */
        function semCamposDeFunctionMembro() {
          return !request.resource.data.keys().hasAny(['status', 'ultimaAtividadeEm']);
        }

        /** Update de cliente não TOCA campos de Function (RN-102). */
        function camposDeFunctionMembroIntocados() {
          return !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['status', 'ultimaAtividadeEm']);
        }

        allow read: if isPlatformAdmin()
                    || isTenantMember(tenantDoClubePai());
        allow create: if (isTenantWriter(request.resource.data.tenantId)
                          && request.resource.data.tenantId == tenantDoClubePai()
                          && tenantAtivo(request.resource.data.tenantId)
                          && papelMembroValido()
                          && entradaViaValida()
                          && semCamposDeFunctionMembro())
                      || isPlatformAdmin();
        allow update: if (isTenantWriter(resource.data.tenantId)
                          && request.resource.data.tenantId == resource.data.tenantId
                          && tenantAtivo(resource.data.tenantId)
                          && papelMembroValido()
                          && entradaViaValida()
                          && camposDeFunctionMembroIntocados())
                      || isPlatformAdmin();
        allow delete: if (isTenantWriter(resource.data.tenantId)
                          && tenantAtivo(resource.data.tenantId))
                      || isPlatformAdmin();
      }

      // `desafios/{desafioId}` — motor de engajamento (E05 · S105-T1).
      //
      // RN-110/116/117: modelo/recompensa/visibilidade dentro dos enums.
      // Agregados ∑ de progresso (qtdParticipantes, progressoPct,
      // progressoPorPilar) são de escrita EXCLUSIVA da Cloud Function
      // (registros de ação chegam no E13): create exige zerados/ausentes,
      // update não pode tocá-los. `clubes.qtdDesafiosAtivos` é recontado
      // pela Function onDesafioWrite. Validações condicionais por modelo
      // (meta por ação no A; minimoPorPilar no C — RN-111) vivem em
      // packages/core (validarPublicacao, S106-T1) — a Rule trava enums e
      // campos de Function; o "publicar" honesto é responsabilidade do
      // cliente autenticado do próprio tenant.
      match /desafios/{desafioId} {

        /** Shape básico do desafio — enums canônicos (RN-110/116/117). */
        function shapeDesafioValido() {
          return request.resource.data.modelo in ['A', 'B', 'C']
            && request.resource.data.status in ['rascunho', 'ativo', 'encerrado']
            && request.resource.data.recompensaTipo in
                ['medalha_digital', 'cupom', 'medalha_fisica', 'custom']
            && request.resource.data.visibilidade in ['membros', 'convite', 'publico']
            && request.resource.data.nome is string
            && request.resource.data.nome.size() > 0;
        }

        /** Agregados ∑ nascem zerados/ausentes — cliente nunca inventa progresso. */
        function desafioAgregadosZerados() {
          return request.resource.data.get('qtdParticipantes', 0) == 0
            && request.resource.data.get('progressoPct', 0) == 0
            && !('progressoPorPilar' in request.resource.data);
        }

        /** Update de cliente não toca campos ∑ (só a Function os mantém). */
        function desafioAgregadosIntocados() {
          return !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['qtdParticipantes', 'progressoPct', 'progressoPorPilar']);
        }

        allow read: if isPlatformAdmin()
                    || isTenantMember(tenantDoClubePai());
        allow create: if (isTenantWriter(request.resource.data.tenantId)
                          && request.resource.data.tenantId == tenantDoClubePai()
                          && tenantAtivo(request.resource.data.tenantId)
                          && shapeDesafioValido()
                          && desafioAgregadosZerados())
                      || isPlatformAdmin();
        allow update: if (isTenantWriter(resource.data.tenantId)
                          && request.resource.data.tenantId == resource.data.tenantId
                          && tenantAtivo(resource.data.tenantId)
                          && shapeDesafioValido()
                          && desafioAgregadosIntocados())
                      || isPlatformAdmin();
        allow delete: if (isTenantWriter(resource.data.tenantId)
                          && tenantAtivo(resource.data.tenantId))
                      || isPlatformAdmin();

        // Junção N:N Desafio↔CatálogoAção — `acoes/{acaoId}` (docId = id da
        // ação no catálogo global). `meta` opcional (obrigatória só no
        // Modelo A — validação de publicação em core, S106-T1).
        match /acoes/{acaoId} {

          /** Shape da junção: acaoRef coerente com o docId; meta number > 0. */
          function shapeAcaoDesafioValido() {
            return request.resource.data.acaoRef is string
              && request.resource.data.acaoRef == acaoId
              && (!('meta' in request.resource.data)
                  || (request.resource.data.meta is number
                      && request.resource.data.meta > 0));
          }

          allow read: if isPlatformAdmin()
                      || isTenantMember(tenantDoClubePai());
          allow create, update: if (isTenantWriter(tenantDoClubePai())
                                    && tenantAtivo(tenantDoClubePai())
                                    && shapeAcaoDesafioValido())
                                || isPlatformAdmin();
          allow delete: if (isTenantWriter(tenantDoClubePai())
                            && tenantAtivo(tenantDoClubePai()))
                        || isPlatformAdmin();
        }
      }

      match /{subcol}/{docId} {
        allow read: if isPlatformAdmin()
                    || isTenantMember(tenantDoClubePai());
        allow write: if isPlatformAdmin();
      }
    }

    // Coleção legada `/inscritos` (top-level) — APOSENTADA (review Onda1 #4).
    // Inscrito vive APENAS na subcoleção canônica `eventos/{id}/inscritos`
    // (E03 · S203-T1), que valida shape + guarda campos de Function. A rule
    // legada (mais fraca — sem shape, sem guarda de kit/status/chip/qrToken)
    // foi removida: o caminho top-level cai no deny-by-default do final do
    // arquivo. NÃO reintroduzir sem rule endurecida + teste adversarial.

    match /comunicados/{docId} {
      allow read: if isTenantMember(resource.data.tenantId) || isPlatformAdmin();
      allow create: if (isTenantWriter(request.resource.data.tenantId)
                        && tenantAtivo(request.resource.data.tenantId))
                    || isPlatformAdmin();
      allow update: if (isTenantWriter(resource.data.tenantId)
                        && request.resource.data.tenantId == resource.data.tenantId
                        && tenantAtivo(resource.data.tenantId))
                    || isPlatformAdmin();
      allow delete: if (isTenantWriter(resource.data.tenantId)
                        && tenantAtivo(resource.data.tenantId))
                    || isPlatformAdmin();
    }

    match /parcerias/{docId} {
      allow read: if isTenantMember(resource.data.tenantId) || isPlatformAdmin();
      allow create: if (isTenantWriter(request.resource.data.tenantId)
                        && tenantAtivo(request.resource.data.tenantId))
                    || isPlatformAdmin();
      allow update: if (isTenantWriter(resource.data.tenantId)
                        && request.resource.data.tenantId == resource.data.tenantId
                        && tenantAtivo(resource.data.tenantId))
                    || isPlatformAdmin();
      allow delete: if (isTenantWriter(resource.data.tenantId)
                        && tenantAtivo(resource.data.tenantId))
                    || isPlatformAdmin();
    }

    match /programaAfiliacao/{docId} {
      allow read: if isTenantMember(resource.data.tenantId) || isPlatformAdmin();
      allow create: if (isTenantWriter(request.resource.data.tenantId)
                        && tenantAtivo(request.resource.data.tenantId))
                    || isPlatformAdmin();
      allow update: if (isTenantWriter(resource.data.tenantId)
                        && request.resource.data.tenantId == resource.data.tenantId
                        && tenantAtivo(resource.data.tenantId))
                    || isPlatformAdmin();
      allow delete: if (isTenantWriter(resource.data.tenantId)
                        && tenantAtivo(resource.data.tenantId))
                    || isPlatformAdmin();
    }

    match /pagamentos/{docId} {
      allow read: if isTenantMember(resource.data.tenantId) || isPlatformAdmin();
      // Escrita de estado financeiro apenas por Function
      allow write: if false;
    }

    // `equipe` — gestão de time do tenant: write restrito ao tenant_owner
    // (staff/promoter não gerenciam a própria equipe pelo cliente).
    match /equipe/{docId} {
      allow read: if isTenantMember(resource.data.tenantId) || isPlatformAdmin();
      allow create: if (isTenantOwner(request.resource.data.tenantId)
                        && tenantAtivo(request.resource.data.tenantId))
                    || isPlatformAdmin();
      allow update: if (isTenantOwner(resource.data.tenantId)
                        && request.resource.data.tenantId == resource.data.tenantId
                        && tenantAtivo(resource.data.tenantId))
                    || isPlatformAdmin();
      allow delete: if (isTenantOwner(resource.data.tenantId)
                        && tenantAtivo(resource.data.tenantId))
                    || isPlatformAdmin();
    }

    match /promotores/{docId} {
      allow read: if isTenantMember(resource.data.tenantId) || isPlatformAdmin();
      allow create: if (isTenantWriter(request.resource.data.tenantId)
                        && tenantAtivo(request.resource.data.tenantId))
                    || isPlatformAdmin();
      allow update: if (isTenantWriter(resource.data.tenantId)
                        && request.resource.data.tenantId == resource.data.tenantId
                        && tenantAtivo(resource.data.tenantId))
                    || isPlatformAdmin();
      allow delete: if (isTenantWriter(resource.data.tenantId)
                        && tenantAtivo(resource.data.tenantId))
                    || isPlatformAdmin();
    }

    // `itensKit/{itemId}` — catálogo de itens de kit do organizador
    // (E03 · S205-T1). Tenant-scoped; item referencia kits do evento via
    // `kits[]` (N:N Kit↔Item — RN-215) e carrega `eventoId`.
    //
    // Shape: RN-212 (tamanhado bool), RN-213 (origem organizador|patrocinador),
    // RN-214 (exibirLogo só faz sentido em item patrocinado — organizador
    // sempre false). `usadoEm` é índice inverso DESNORMALIZADO mantido pela
    // Function itemKitIndex — cliente nunca escreve.
    match /itensKit/{itemId} {

      /** Shape do item (RN-212/213/214) — enums e booleans coerentes. */
      function shapeItemKitValido() {
        return request.resource.data.nome is string
          && request.resource.data.nome.size() > 0
          && request.resource.data.tamanhado is bool
          && request.resource.data.origem in ['organizador', 'patrocinador']
          && request.resource.data.exibirLogo is bool
          && (request.resource.data.origem == 'patrocinador'
              || request.resource.data.exibirLogo == false)
          && request.resource.data.kits is list
          && request.resource.data.eventoId is string
          && request.resource.data.eventoId.size() > 0;
      }

      /**
       * Coerência de tenant com o EVENTO referenciado (ADR-009): o item só
       * aponta evento do PRÓPRIO tenant — sem itens órfãos em evento alheio.
       */
      function eventoDoItemCoerente() {
        return get(/databases/$(database)/documents/eventos/$(request.resource.data.eventoId))
          .data.tenantId == request.resource.data.tenantId;
      }

      /** Cliente não CRIA item com índice inverso carimbado (só Function). */
      function semUsadoEm() {
        return !request.resource.data.keys().hasAny(['usadoEm']);
      }

      /** Update de cliente não TOCA o índice inverso (só Function). */
      function usadoEmIntocado() {
        return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['usadoEm']);
      }

      allow read: if isTenantMember(resource.data.tenantId) || isPlatformAdmin();
      allow create: if (isTenantWriter(request.resource.data.tenantId)
                        && tenantAtivo(request.resource.data.tenantId)
                        && shapeItemKitValido()
                        && eventoDoItemCoerente()
                        && semUsadoEm())
                    || isPlatformAdmin();
      allow update: if (isTenantWriter(resource.data.tenantId)
                        && request.resource.data.tenantId == resource.data.tenantId
                        && tenantAtivo(resource.data.tenantId)
                        && shapeItemKitValido()
                        && eventoDoItemCoerente()
                        && usadoEmIntocado())
                    || isPlatformAdmin();
      allow delete: if (isTenantWriter(resource.data.tenantId)
                        && tenantAtivo(resource.data.tenantId))
                    || isPlatformAdmin();
    }

    // ── Coleções globais ──────────────────────────────────────────────────

    /**
     * `atletas/{atletaId}` — identidade global cross-tenant (ADR-009).
     * Leitura: o próprio atleta (uid bate com o doc) ou platform_admin.
     * Escrita: o próprio atleta ou Function (onCreateUser usa Admin SDK).
     *
     * Nota: Functions gravam via Admin SDK e não passam por estas Rules.
     */
    match /atletas/{atletaId} {
      allow read: if (isSignedIn() && request.auth.uid == atletaId)
                  || isPlatformAdmin();
      allow write: if isSignedIn() && request.auth.uid == atletaId;
    }

    match /catalogoAcoes/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if isPlatformAdmin();
    }

    // ── `profissionais/{profId}` — tenant-scoped via claim ────────────────
    match /profissionais/{profId} {
      allow read: if (isSignedIn() && request.auth.uid == profId)
                  || (isSignedIn() && isTenantMember(resource.data.tenantId))
                  || isPlatformAdmin();
      allow write: if isPlatformAdmin();

      // `dashboard/{docId}` — agregado ∑ do painel do profissional
      // (E02 · S600-T2: KPIs + alertas em `dashboard/current`).
      //
      // ESCRITA: NUNCA pelo cliente — o doc é mantido exclusivamente pela
      // Cloud Function (Admin SDK bypassa Rules). Qualquer write de cliente
      // é fraude de KPI; negado até para platform_admin (que escreve, se
      // precisar, via Admin SDK — nunca pelo SDK de cliente).
      //
      // LEITURA: só o PRÓPRIO profissional (uid == profId) e platform_admin
      // (visão macro). Staff do MESMO tenant não lê dashboard alheio — o
      // agregado é do indivíduo, não do tenant; o painel consome via
      // callable `getOverview`, a leitura direta fica para debug/fallback.
      match /dashboard/{docId} {
        allow read: if (isSignedIn() && request.auth.uid == profId)
                    || isPlatformAdmin();
        allow write: if false;
      }
    }

    // ── Bloqueia qualquer coleção não modelada acima ─────────────────────
    // Deny-by-default — não inverta sem rule explícita e testada.
    match /{document=**} {
      allow read, write: if false;
    }

  }
}
