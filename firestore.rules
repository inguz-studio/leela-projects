// firestore.rules — LEELA · Onda 0
//
// Deny-by-default: toda coleção é bloqueada por padrão.
// Isolamento multi-tenant completo em S1600-T3 (ADR-009).
// Hardening pós-review S1600 (fix write-takeover cross-tenant):
//   - create/update/delete separados em TODA coleção tenant-scoped;
//   - update valida o DONO ATUAL (resource.data.tenantId) e exige
//     tenantId IMUTÁVEL (request.resource.data.tenantId == resource.data.tenantId);
//   - delete valida o dono atual;
//   - writes de cliente exigem papel de escrita (tenant_owner/tenant_staff),
//     nunca promoter/athlete (RBAC intra-tenant mínimo).
//
// Partição de coleções (ADR-009 §Estratégia de partição):
//   TENANT-SCOPED : eventos, clubes, programaAfiliacao, pagamentos,
//                   equipe, promotores, subscriptions
//                   (inscritos vive APENAS em eventos/{id}/inscritos — E03;
//                   comunicados e parcerias vivem APENAS em clubes/{id}/… —
//                   E05; as top-level /inscritos, /comunicados e /parcerias
//                   foram aposentadas nos reviews Onda1 #4 e #10/S3)
//   GLOBAL        : atletas, catalogoAcoes, config/system
//   PLATAFORMA    : tenants/{id}, tenants/{id}/commercialTerms, platform/…
//
// Helpers de autorização reutilizados em todas as rules:
//   isSignedIn()              — usuário autenticado
//   isPlatformAdmin()         — role == 'platform_admin' no custom claim
//   isTenantMember(tenantId)  — tenantId do claim bate com o documento (leitura)
//   isTenantWriter(tenantId)  — membro com papel de escrita (owner/staff)
//   isTenantOwner(tenantId)   — apenas tenant_owner (writes mais sensíveis)
//   tenantAtivo(tenantId)     — bloqueia escrita em tenant suspenso (RN-402)

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers de autorização (ADR-009) ───────────────────────────────────

    /** Usuário autenticado */
    function isSignedIn() {
      return request.auth != null;
    }

    /** platform_admin: acesso cross-tenant (leitura macro + configuração) */
    function isPlatformAdmin() {
      return isSignedIn() && request.auth.token.role == 'platform_admin';
    }

    /**
     * Membro do tenant: claim.tenantId bate com o tenantId do recurso.
     * Usado para LEITURA em coleção tenant-scoped (RN-400).
     * Qualquer papel com claim de tenant (owner/staff/promoter) lê o próprio tenant.
     */
    function isTenantMember(tenantId) {
      return isSignedIn() && request.auth.token.tenantId == tenantId;
    }

    /**
     * Papel de ESCRITA dentro do tenant: tenant_owner ou tenant_staff.
     * promoter é membro (lê), mas NÃO escreve dados de domínio pelo cliente.
     * Nota de dívida: o épico S1600 exige isolamento ENTRE tenants (RN-400);
     * o RBAC intra-tenant fino (por coleção/campo) adensa em stories futuras.
     */
    function isTenantWriter(tenantId) {
      return isTenantMember(tenantId)
        && (request.auth.token.role == 'tenant_owner'
            || request.auth.token.role == 'tenant_staff');
    }

    /** Apenas o tenant_owner — writes mais sensíveis (ex.: equipe). */
    function isTenantOwner(tenantId) {
      return isTenantMember(tenantId)
        && request.auth.token.role == 'tenant_owner';
    }

    /**
     * Tenant ativo: bloqueia ESCRITA quando o tenant está suspenso (RN-402).
     * Só nega writes; reads de dados existentes permanecem (leitura preservada).
     * Requer leitura do doc tenants/{tenantId} — usa get().
     */
    function tenantAtivo(tenantId) {
      return get(/databases/$(database)/documents/tenants/$(tenantId)).data.status == 'ativo';
    }

    /** Status de tenant válido (RN-402) — valida enum na escrita de tenants. */
    function isValidTenantStatus(status) {
      return status in ['pending', 'ativo', 'suspenso'];
    }

    /**
     * Valor monetário escrito por CLIENTE: number FINITO e cent-exato (R$,
     * 2 casas) — espelho de parseMoney/roundMoney do core (re-review Fable
     * S300 #6): `preco >= 0` sozinho aceitava Infinity, e sub-centavo
     * (75.001) entrava em doc financeiro. Int é cent-exato por definição.
     * FINITUDE por aritmética (fix pós-emulator): o runtime de Rules do
     * Emulator (firebase-tools 13) NÃO implementa `math.isInfinite`
     * ("Function not found" → evaluation error → negava até float LEGÍTIMO
     * de 2 casas). `v * 0.0 == 0.0` é o equivalente portável: NaN e ±Infinity
     * falham a igualdade (IEEE-754); todo finito passa. No float, a
     * tolerância 0.001 (em CENTAVOS — 1/1000 de centavo) absorve com folga o
     * ruído de ponto flutuante da multiplicação ×100 (~1e-12 para preços
     * reais); sub-centavo REAL fica ≥ 0.1 centavo de distância do inteiro
     * (99.999 → 0.1; 75.005 → 0.5) e segue negado. Ranges (≥ 0, > 0, ≤ 100)
     * seguem nos shapes de cada coleção.
     */
    function moneyCentExato(v) {
      return v is int
        || (v is float
            && v * 0.0 == 0.0
            && math.abs(v * 100.0 - math.round(v * 100.0)) < 0.001);
    }

    // ── `tenants/{tenantId}` — coleção de plataforma ──────────────────────
    //
    // Leitura: membro do tenant (claim.tenantId bate) OU platform_admin.
    // Escrita: APENAS platform_admin (ou Function/Admin SDK via bypass de Rules).
    // Transições de status passam pela Function `transitionTenant`
    // (valida canTransition — RN-402); a rule ao menos trava o enum.
    //
    // RN-400: dado de um tenant nunca é legível por outro tenant.
    // RN-401: papel vem do custom claim, não do cliente.
    // RN-404: termos comerciais exclusivo do platform_admin.
    match /tenants/{tenantId} {
      allow read: if isTenantMember(tenantId) || isPlatformAdmin();
      allow create, update: if isPlatformAdmin()
                            && isValidTenantStatus(request.resource.data.status);
      allow delete: if isPlatformAdmin();

      // `commercialTerms/{doc}` — termos por tenant (E16 · S1602-T1)
      //
      // Leitura: membro do tenant (read-only) ou platform_admin.
      // Escrita: APENAS platform_admin (RN-404) — defesa em profundidade:
      // a Rule revalida ranges (RN-405: saasMonthlyFee 0 é VÁLIDO) e o
      // versionamento que o core/api-client já validam no cliente.
      //
      // Versionamento (fonte de auditoria econômica — RN-406):
      //   - `current`: create exige versao == 1; update exige bump exato
      //     (versao == anterior + 1); delete NEGADO (termo vigente nunca some);
      //   - snapshots `v{n}`: create-only com nome coerente à versao
      //     (histórico imutável — update/delete negados até para admin).
      match /commercialTerms/{doc} {

        /** TAXAFLEX (RN-178): linha `{percentual, fixoCentavos}` da tabela
            por meio. percentual finito 0–100 em passo 0,01% (basis point —
            NaN/Infinity falham as comparações, fail-closed; mesmo idioma de
            moneyCentExato) e fixoCentavos INTEIRO 0–100000 (R$ 1.000 teto
            de sanidade — espelho de TAXA_FIXO_CENTAVOS_MAX no core). */
        function taxaMeioValido(linha) {
          return linha is map
            && linha.keys().hasOnly(['percentual', 'fixoCentavos'])
            && linha.keys().hasAll(['percentual', 'fixoCentavos'])
            && linha.percentual is number
            && linha.percentual >= 0
            && linha.percentual <= 100
            && linha.percentual * 0.0 == 0.0
            && math.abs(linha.percentual * 100.0 - math.round(linha.percentual * 100.0)) < 0.001
            && linha.fixoCentavos is int
            && linha.fixoCentavos >= 0
            && linha.fixoCentavos <= 100000;
        }

        /** Shape completo dos termos + ranges (RN-404/405/410). */
        function termsShapeValido() {
          return request.resource.data.keys().hasAll([
              'platformFeePct', 'installmentRules', 'anticipation',
              'communityMonthlyEnabled', 'saasMonthlyFee', 'versao',
              'atualizadoPor', 'atualizadoEm'
            ])
            && request.resource.data.platformFeePct is number
            && request.resource.data.platformFeePct >= 0
            && request.resource.data.platformFeePct <= 100
            && request.resource.data.saasMonthlyFee is number
            && request.resource.data.saasMonthlyFee >= 0
            && request.resource.data.installmentRules is map
            && request.resource.data.installmentRules.maxParcelas is int
            && request.resource.data.installmentRules.maxParcelas >= 1
            && request.resource.data.installmentRules.jurosAoMes is number
            && request.resource.data.installmentRules.jurosAoMes >= 0
            && request.resource.data.installmentRules.parcelaMinima is number
            && request.resource.data.installmentRules.parcelaMinima >= 0
            && request.resource.data.anticipation is map
            && request.resource.data.anticipation.disponivel is bool
            && (!('custoPct' in request.resource.data.anticipation)
                || (request.resource.data.anticipation.custoPct is number
                    && request.resource.data.anticipation.custoPct >= 0
                    && request.resource.data.anticipation.custoPct <= 100))
            && request.resource.data.communityMonthlyEnabled is bool
            && request.resource.data.versao is int
            && request.resource.data.versao >= 1
            && request.resource.data.atualizadoPor is string
            // E09s-L1 (RN-348/350 · decisão #4): campos de repasse OPCIONAIS
            // — quando presentes, range travado (NaN/Infinity falham as
            // comparações — fail-closed; sem math.isInfinite: o runtime do
            // Emulator não a implementa, ver moneyCentExato).
            && (!('retencaoRepassePct' in request.resource.data)
                || (request.resource.data.retencaoRepassePct is number
                    && request.resource.data.retencaoRepassePct >= 0
                    && request.resource.data.retencaoRepassePct <= 100))
            && (!('disponibilizacaoDiasUteis' in request.resource.data)
                || (request.resource.data.disponibilizacaoDiasUteis is int
                    && request.resource.data.disponibilizacaoDiasUteis >= 0))
            // Onda 2 (T2-L4 · decisão #15): taxa por método + tabela por
            // parcela OPCIONAIS — quando presentes, ranges travados
            // (NaN/Infinity falham comparação — fail-closed, como acima).
            // Estampados pelo aplicarPlano (Admin SDK) e reeditáveis
            // campo-a-campo pelo editor S1602-T2 (client, ESTA rule).
            && (!('taxaPorMetodo' in request.resource.data)
                || (request.resource.data.taxaPorMetodo is map
                    && request.resource.data.taxaPorMetodo.credit_card is number
                    && request.resource.data.taxaPorMetodo.credit_card >= 0
                    && request.resource.data.taxaPorMetodo.credit_card <= 100
                    && request.resource.data.taxaPorMetodo.pix is number
                    && request.resource.data.taxaPorMetodo.pix >= 0
                    && request.resource.data.taxaPorMetodo.pix <= 100))
            && (!('tabelaTaxasParcela' in request.resource.data)
                || request.resource.data.tabelaTaxasParcela is map)
            // TAXAFLEX (RN-178/404): override da tabela por meio OPCIONAL e
            // PARCIAL — quando presente, só chaves do enum e cada linha
            // presente com shape/range travados (fail-closed).
            && (!('taxaTabela' in request.resource.data)
                || (request.resource.data.taxaTabela is map
                    && request.resource.data.taxaTabela.keys().hasOnly(['pix', 'cartao', 'boleto'])
                    && (!('pix' in request.resource.data.taxaTabela)
                        || taxaMeioValido(request.resource.data.taxaTabela.pix))
                    && (!('cartao' in request.resource.data.taxaTabela)
                        || taxaMeioValido(request.resource.data.taxaTabela.cartao))
                    && (!('boleto' in request.resource.data.taxaTabela)
                        || taxaMeioValido(request.resource.data.taxaTabela.boleto))))
            // Rastro de plano aplicado (CB-T2) — referência MORTA, tipada
            && (!('planoAplicadoId' in request.resource.data)
                || request.resource.data.planoAplicadoId is string)
            && (!('planoAplicadoEm' in request.resource.data)
                || request.resource.data.planoAplicadoEm is timestamp);
        }

        allow read: if isTenantMember(tenantId) || isPlatformAdmin();
        // create: `current` nasce na versao 1; snapshot exige nome coerente
        allow create: if isPlatformAdmin()
                      && termsShapeValido()
                      && (doc == 'current'
                            ? request.resource.data.versao == 1
                            : doc == 'v' + string(request.resource.data.versao));
        // update: SÓ `current`, com bump exato (snapshots são imutáveis)
        allow update: if isPlatformAdmin()
                      && doc == 'current'
                      && termsShapeValido()
                      && request.resource.data.versao == resource.data.versao + 1;
        // delete: NUNCA — termo vigente não some; histórico é preservado
        allow delete: if false;
      }

      // `subscriptions/{subId}` — mensalidades da comunidade (S1603)
      // Status escrito só por Function; leitura pelo atleta dono e pelo tenant.
      match /subscriptions/{subId} {
        allow read: if isTenantMember(tenantId)
                    || isPlatformAdmin()
                    || (isSignedIn() && request.auth.uid == resource.data.atletaId);
        // Cliente não escreve status/proximaCobranca — só Function (Admin SDK)
        allow write: if false;
      }

      // ── Repasse do organizador — E09-slim (E09s-L1-T2 · RN-354/357) ─────
      //
      // As 4 coleções do repasse são TENANT-SCOPED POR CAMINHO: o isolamento
      // cross-tenant (RN-354/400) sai do próprio match — o tenantId do path
      // é o único escopo consultado, sem depender de campo no doc.
      // ESCRITA DE CLIENTE: NEGADA NAS QUATRO (RN-357) — repasse/saldo/dados
      // bancários só mudam por Function (Admin SDK bypassa Rules). Vale até
      // para platform_admin via client SDK (mesmo padrão de `pedidos`/
      // `pagamentos`/`financeiro`: dinheiro forjado no cliente é fraude).

      // `dadosBancarios/{docId}` — versão MASCARADA (RN-354): `****1234`,
      // PIX/CPF-CNPJ mascarados. Mesmo mascarado é dado bancário PESSOAL
      // (LGPD): leitura SÓ tenant_owner (não staff/promoter — minimização;
      // o fluxo de saque L3 é do dono) e platform_admin (back-office L4
      // confere o favorecido). Escrita: só a Function `saveDadosBancarios`
      // (L2-T2), que mascara server-side.
      match /dadosBancarios/{docId} {
        allow read: if isTenantOwner(tenantId) || isPlatformAdmin();
        allow write: if false;
      }

      // `dadosBancariosSecret/{docId}` — blob CIFRADO do número/PIX em
      // claro (RN-354): ILEGÍVEL por TODO cliente, INCLUSIVE o próprio
      // tenant_owner e platform_admin via client SDK. Leitura admin é
      // superfície EXCLUSIVA do callable auditado `getBankDetailsForPayout`
      // (L2-T5 — registra quem/quando/qual repasse, LGPD). NÃO abrir read
      // aqui NUNCA — o doc em claro decifrado não transita pelo Firestore.
      match /dadosBancariosSecret/{docId} {
        allow read, write: if false;
      }

      // `repasses/{repasseId}` — solicitações de saque (RN-352/353/355/356).
      // LEITURA: taxonomia FINANCEIRA do arquivo (owner/staff gerem dinheiro;
      // promoter/athlete-com-claim NÃO) + platform_admin cross-tenant (fila
      // de aprovação L4). ESCRITA: NEGADA — estado/valor/transicoes[]/
      // comprovanteNumero são de Function (requestRepasse, cancelRepasse,
      // approveRepasse, rejectRepasse, markRepassePago — RN-353/357); um
      // cliente que escrevesse `estado:'pago'` fabricaria comprovante sem
      // pagamento, e um `valor` editado após aprovação fraudaria o saque.
      match /repasses/{repasseId} {
        allow read: if isTenantWriter(tenantId) || isPlatformAdmin();
        allow write: if false;
      }

      // `saldo/{docId}` — ∑ consolidado do tenant (`current` — RN-350/351).
      // Recomputado INTEGRALMENTE pela Function `updateSaldoRepasse` (L2-T1)
      // via computeSaldoRepasse do core; os 3 cards do painel-slim leem SÓ
      // este doc (nunca somam eventos no cliente). Mesma taxonomia de
      // leitura financeira; escrita de cliente = saldo forjado (RN-357).
      match /saldo/{docId} {
        allow read: if isTenantWriter(tenantId) || isPlatformAdmin();
        allow write: if false;
      }

      // `parceirosAssessoria/{parceriaId}` — vínculo organizador↔assessoria
      // (E18 · S1800/S1801/S1803 · RN-360..365). Subcoleção NOVA com PII
      // (documento CNPJ/CPF + e-mail do responsável) ⇒ REGRA PRÓPRIA
      // (diretriz O3-L3B; nunca catch-all). docId = documento normalizado
      // (dedupe por chave — RN-361).
      // LEITURA: papel de ESCRITA do tenant (owner/staff gerem parceiros;
      // promoter/athlete-com-claim NÃO leem CPF/CNPJ de terceiros — LGPD,
      // minimização) + platform_admin. ESCRITA: NEGADA para TODO client SDK
      // (postura pós-19c8afe) — cadastro/aceite/encerramento passam pelas
      // Functions cadastrarAssessoriaParceira / provisionAssessoriaAccount /
      // encerrarParceriaAssessoria (máquina de estados + convite + token
      // só são invariantes lá).
      match /parceirosAssessoria/{parceriaId} {
        allow read: if isTenantWriter(tenantId) || isPlatformAdmin();
        allow write: if false;
      }

      // `crmClientes/{clienteKey}` — CRM do organizador (E19 · S-R9-13-T2 ·
      // RN-172): cliente consolidado cross-evento com LTV + histórico.
      // PII INDIVIDUAL (nome, nascimento, gênero, valores) — categoria
      // DISTINTA do agregado RN-820. Regra própria (diretriz O3-L3B).
      //
      // LEITURA: SÓ papel de ESCRITA do tenant (owner/staff) — o épico manda
      // "leitura só isTenantWriter": promoter/afiliado/patrocinador/
      // coordenador/atleta NUNCA leem, e NEM platform_admin via client SDK
      // (mais restrito que parceirosAssessoria de propósito — perfil
      // comportamental individual; back-office usa Admin SDK auditável).
      // ESCRITA: NEGADA para TODO cliente — o doc é projeção EXCLUSIVA da
      // Function onInscritoWriteCrm (ledger + recompute transacional);
      // um cliente que escrevesse aqui forjaria LTV/histórico ou plantaria
      // PII fora da finalidade declarada (RN-172).
      // TRAVA DE REGRESSÃO (review antagonista E19 · A5): esta regra é
      // path-scoped; hoje NENHUMA query usa collectionGroup('crmClientes').
      // Se um dia criarem índice/consulta de collection-group aqui, REVALIDAR
      // no emulator que a leitura cross-tenant segue negada.
      match /crmClientes/{clienteKey} {
        allow read: if isTenantWriter(tenantId);
        allow write: if false;
      }
    }

    // ── `platform/{doc}` — dados macro da plataforma ──────────────────────
    // Leitura: apenas platform_admin.
    // Escrita: apenas Function/Admin SDK (client nunca escreve).
    match /platform/{doc=**} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }

    // ── `planosCobranca/{planoId}` — planos de cobrança da PLATAFORMA ─────
    // (Onda 2 T2-L4 · CB-T1 · decisão #15). Catálogo PRIVADO do
    // platform_admin: read E write só dele — tenant NUNCA enxerga os
    // planos (só o resultado estampado nos próprios commercialTerms).
    // Aplicar plano NÃO passa por aqui: é o callable `aplicarPlano`
    // (Admin SDK) que estampa a versão nos termos do tenant.
    // Nota de path: o brief grafou `platform/planosCobranca/{planoId}`
    // (caminho de doc inválido — segmentos ímpares); normalizado para
    // coleção top-level com a MESMA semântica platform-scoped.
    match /planosCobranca/{planoId} {

      /** Shape do plano — espelho de validarPlanoCobranca (core).
          Finitude sem math.isInfinite: NaN/±Infinity falham as
          comparações de range (fail-closed). */
      function shapePlanoValido() {
        return request.resource.data.nome is string
          && request.resource.data.nome.trim().size() > 0
          && request.resource.data.nome.size() <= 60
          && request.resource.data.taxaPix is number
          && request.resource.data.taxaPix >= 0
          && request.resource.data.taxaPix <= 100
          && request.resource.data.taxaCartaoAVista is number
          && request.resource.data.taxaCartaoAVista >= 0
          && request.resource.data.taxaCartaoAVista <= 100
          && request.resource.data.saasMonthlyFee is number
          && request.resource.data.saasMonthlyFee >= 0
          && request.resource.data.saasMonthlyFee * 0.0 == 0.0
          && request.resource.data.tabelaTaxasParcela is map;
      }

      allow read: if isPlatformAdmin();
      allow create, update: if isPlatformAdmin() && shapePlanoValido();
      allow delete: if isPlatformAdmin();
    }

    // ── Coleções tenant-scoped ────────────────────────────────────────────
    //
    // Toda coleção de domínio carrega `tenantId` (ADR-009).
    // Padrão seguro (fix write-takeover):
    //   read   — membro do tenant DONO ATUAL (resource) ou platform_admin;
    //   create — papel de escrita no tenant carimbado + tenant ativo (RN-402);
    //   update — papel de escrita no tenant DONO ATUAL + tenantId imutável
    //            + tenant ativo;
    //   delete — papel de escrita no tenant DONO ATUAL + tenant ativo.
    //
    // Coleções: eventos, clubes, comunicados, parcerias,
    //           programaAfiliacao, pagamentos, equipe, promotores, subscriptions
    // (inscritos: só a subcoleção eventos/{id}/inscritos — review Onda1 #4)

    // `eventos/{eventoId}` — Operação do Evento (E03 · S200-T1). docId = slug.
    //
    // Além do padrão tenant-scoped:
    //   - agregados ∑ (qtdInscritos, receitaConfirmada) são de escrita
    //     EXCLUSIVA da Cloud Function (Admin SDK): create exige 0/ausente,
    //     update não pode tocá-los;
    //   - CICLO DE VIDA é de escrita EXCLUSIVA de Function (ADR-005 — fix
    //     review Onda1 #18): create nasce 'rascunho'; update de cliente NÃO
    //     toca `status`. Publicar/encerrar passam por `publicarEvento` &
    //     afins (Admin SDK), que validam completude/publicadoEm/URL/QR;
    //   - delete NEGADO para TODO cliente (fix review Onda1 #17, precedente
    //     S110/RN-144 dos clubes): subcoleções não cascateiam — deletar
    //     evento vendido órfãnaria os inscritos (PII, LGPD). Exclusão real é
    //     superfície de Function com cascata (handoff E04) ou tooling Admin.
    match /eventos/{eventoId} {

      /** Agregados ∑ nascem zerados (ou ausentes) — cliente nunca inventa contagem. */
      function eventoAgregadosZerados() {
        return request.resource.data.get('qtdInscritos', 0) == 0
          && request.resource.data.get('receitaConfirmada', 0) == 0;
      }

      /** Update de cliente não toca campos ∑ (só a Function os mantém). */
      function eventoAgregadosIntocados() {
        return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['qtdInscritos', 'receitaConfirmada']);
      }

      /**
       * ADR-005 (review #18): cliente NUNCA grava status. Create = sempre
       * 'rascunho'; transições (publicado/ao_vivo/encerrado) são de Function.
       */
      function statusNasceRascunho() {
        return request.resource.data.status == 'rascunho';
      }

      /** Update de cliente não TOCA `status` (transição é da Function). */
      function statusIntocado() {
        return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['status']);
      }

      /**
       * RN-200 (S201-T3): após a 1ª venda (∑ qtdInscritos > 0) o cliente não
       * toca `percursos` — o preço faz parte do percurso. Sem venda, edita.
       * `modalidades` incluso (re-review Fable S300 #4-rules): os lotes
       * referenciam `evento.modalidades` (ADR-012) — renomear/remover uma
       * modalidade vendida órfãnaria lotes e inscritos dela.
       */
      function percursosEditaveis() {
        return resource.data.get('qtdInscritos', 0) == 0
          || !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['percursos', 'modalidades']);
      }

      /**
       * FABLE-F-T1: cronograma de entrega — quando presente, é LISTA com no
       * máximo 30 janelas (JANELAS_ENTREGA_MAX do core — anti doc-bomba).
       * Shape fino por janela (dia ISO, HH:mm, fim > início) vive no core
       * (parseEvento fail-fast) — Rules não iteram listas; precedente:
       * `percursos`/`modalidades` também validam só `is list`.
       * DECISÃO DE ESCRITA: campo do ORGANIZADOR pelo cliente — segue o
       * padrão vigente dos campos descritivos do evento (nome/local/data):
       * não é agregado ∑ nem carimbo de Function.
       */
      function janelasEntregaValidas() {
        return !('janelasEntrega' in request.resource.data)
          || (request.resource.data.janelasEntrega is list
              && request.resource.data.janelasEntrega.size() <= 30);
      }

      /**
       * FABLE-F-T1: faixa de chips — quando presente, é null (não
       * configurada) ou map EXATO {inicio, fim} com ints ≥ 0 e fim ≥ início
       * (faixa aqui é totalmente exprimível em Rules — validada inteira).
       * Mesma decisão de escrita do cronograma: organizador via cliente.
       */
      function faixaChipsValida() {
        return !('faixaChips' in request.resource.data)
          || request.resource.data.faixaChips == null
          || (request.resource.data.faixaChips is map
              && request.resource.data.faixaChips.keys().hasAll(['inicio', 'fim'])
              && request.resource.data.faixaChips.keys().hasOnly(['inicio', 'fim'])
              && request.resource.data.faixaChips.inicio is int
              && request.resource.data.faixaChips.fim is int
              && request.resource.data.faixaChips.inicio >= 0
              && request.resource.data.faixaChips.fim >= request.resource.data.faixaChips.inicio);
      }

      /**
       * EVENTO-CAMPOS (RN-153): capa — quando presente, é null (sem capa) ou
       * URL http(s) curta. A capa vira `src` de <img> na landing PÚBLICA:
       * `javascript:`/`data:` nunca entram no doc (espelho de isUrlCapaValida
       * no core e da validação do criarEvento — defesa em profundidade).
       * RN-200 NÃO congela capa: editável mesmo após a 1ª venda.
       */
      function capaValida() {
        return !('imagemUrl' in request.resource.data)
          || request.resource.data.imagemUrl == null
          || (request.resource.data.imagemUrl is string
              && request.resource.data.imagemUrl.size() <= 2048
              && request.resource.data.imagemUrl.matches('https?://.*'));
      }

      /**
       * EVENTO-CAMPOS (RN-153): regulamento — texto com teto são (50k,
       * REGULAMENTO_MAX do core — anti doc-bomba; doc Firestore é 1 MiB).
       * RN-200 NÃO congela regulamento; o VERSIONAMENTO (RN-149,
       * regulamentoVersao + novo aceite) é do S306/Onda 3.
       */
      function regulamentoValido() {
        return !('regulamento' in request.resource.data)
          || request.resource.data.regulamento == null
          || (request.resource.data.regulamento is string
              && request.resource.data.regulamento.size() <= 50000);
      }

      /**
       * S306-T1 (RN-146): exigências de saúde — quando presente, map EXATO
       * {atestado, parq} com booleans (lixo NUNCA liga coleta de dado
       * sensível). Flags nascem OFF por default no produto (minimização
       * LGPD) — a Rule valida o shape; o default é da UI/core.
       */
      function exigenciasSaudeValidas() {
        return !('exigenciasSaude' in request.resource.data)
          || (request.resource.data.exigenciasSaude is map
              && request.resource.data.exigenciasSaude.keys().hasAll(['atestado', 'parq'])
              && request.resource.data.exigenciasSaude.keys().hasOnly(['atestado', 'parq'])
              && request.resource.data.exigenciasSaude.atestado is bool
              && request.resource.data.exigenciasSaude.parq is bool);
      }

      /**
       * S306 (RN-149/147): campos de escrita EXCLUSIVA de Function no doc do
       * evento — `regulamentoVersao`/`regulamentoAtualizadoEm` (versão é
       * contrato legal MONOTÔNICO, bump só pelo trigger versionarRegulamento)
       * e `saudeExpurgadaEm` (prova do expurgo LGPD — forjá-lo simularia
       * expurgo que não houve). Cliente nem cria nem toca.
       */
      function camposS306NaoNascem() {
        return !request.resource.data.keys().hasAny(
          ['regulamentoVersao', 'regulamentoAtualizadoEm', 'regulamentoTextoHash',
           'saudeExpurgadaEm']
        );
      }
      function camposS306Intocados() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(
          ['regulamentoVersao', 'regulamentoAtualizadoEm', 'regulamentoTextoHash',
           'saudeExpurgadaEm']
        );
      }

      /**
       * EVENTO-CAMPOS (RN-347): modo da taxa — enum FECHADO quando presente
       * (null NÃO é válido: o modo se troca, nunca se "anula"; ausência só
       * existe em doc legado, que os consumidores leem como 'incorporada').
       */
      function taxaModoValido() {
        return !('taxaModo' in request.resource.data)
          || request.resource.data.taxaModo in ['incorporada', 'repassada'];
      }

      /**
       * RN-347: taxaModo CONGELA junto dos campos comerciais após a 1ª venda
       * (∑ qtdInscritos > 0) — trocar quem paga a taxa com venda feita mexe
       * em dinheiro já vendido (repasse E09 + total do comprador E12).
       * Mesmo padrão de percursosEditaveis (RN-200); remover o campo
       * (deleteField) também conta como toque — `affectedKeys` cobre.
       */
      function taxaModoEditavel() {
        return resource.data.get('qtdInscritos', 0) == 0
          || !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['taxaModo']);
      }

      /**
       * RN-303 (S1804 · review antagonista O3-L1 #1): `vendaSomentePorCupom`
       * — boolean ESTRITO quando presente (lixo nunca entra no doc; o parse
       * tolerante do core é a 2ª camada, não a 1ª).
       */
      function vendaSomentePorCupomValida() {
        return !('vendaSomentePorCupom' in request.resource.data)
          || request.resource.data.vendaSomentePorCupom is bool;
      }

      /**
       * RN-303: TOCAR o flag no update é OWNER-ONLY — abrir/fechar o evento
       * a vendas sem cupom é controle de venda do organizador (mesma postura
       * de politicaVendas/S305: staff NÃO). Sem isso, qualquer tenant_staff
       * flipava o modo por client SDK e abria evento fechado (achado MAJOR
       * da review antagonista O3-L1).
       */
      function vendaSomentePorCupomProtegida() {
        return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['vendaSomentePorCupom'])
          || isTenantOwner(resource.data.tenantId);
      }

      // TODO(E04/compra): quando o fluxo de compra entrar, abrir leitura
      // PÚBLICA apenas de eventos com status 'publicado' (athlete/anônimo).
      // NÃO abrir antes — deny-by-default até a story do checkout, com teste.
      // S304-T1: MEMBRO DE EQUIPE (qualquer dos 4 papéis — RN-320) lê o doc
      // do evento em que atua: toda área depende dele (nome/status/percursos).
      // A matriz 4×7 restringe as ÁREAS (subcoleções abaixo), não este doc.
      allow read: if isTenantMember(resource.data.tenantId)
                  || isPlatformAdmin()
                  || papelEventoAtivo(['organizador', 'administrador', 'operador', 'financeiro']);
      allow create: if (isTenantWriter(request.resource.data.tenantId)
                        && tenantAtivo(request.resource.data.tenantId)
                        && eventoAgregadosZerados()
                        && statusNasceRascunho()
                        && janelasEntregaValidas()
                        && faixaChipsValida()
                        && capaValida()
                        && regulamentoValido()
                        && exigenciasSaudeValidas()
                        && camposS306NaoNascem()
                        && taxaModoValido()
                        && vendaSomentePorCupomValida())
                    || isPlatformAdmin();
      allow update: if (isTenantWriter(resource.data.tenantId)
                        && request.resource.data.tenantId == resource.data.tenantId
                        && tenantAtivo(resource.data.tenantId)
                        && eventoAgregadosIntocados()
                        && statusIntocado()
                        && percursosEditaveis()
                        && janelasEntregaValidas()
                        && faixaChipsValida()
                        && capaValida()
                        && regulamentoValido()
                        && exigenciasSaudeValidas()
                        && camposS306Intocados()
                        && taxaModoValido()
                        && taxaModoEditavel()
                        && vendaSomentePorCupomValida()
                        && vendaSomentePorCupomProtegida())
                    || isPlatformAdmin();
      // Delete de evento é EXCLUSIVO de Function/Admin (review #17) — nem
      // platform_admin via client SDK (espelha o delete de clubes, S110-T2).
      allow delete: if false;

      /** tenantId do evento pai — subcoleções carregam tenantId coerente (ADR-009). */
      function tenantDoEventoPai() {
        return get(/databases/$(database)/documents/eventos/$(eventoId)).data.tenantId;
      }

      /** ∑ qtdInscritos do evento pai > 0 ⇒ evento tem venda (RN-200). */
      function eventoPaiTemVenda() {
        return get(/databases/$(database)/documents/eventos/$(eventoId))
          .data.get('qtdInscritos', 0) > 0;
      }

      /**
       * S304-T1 (RN-320 · ADR-008): o caller tem papel de EQUIPE neste
       * evento, dentro da lista `papeis`, E o vínculo está VIVO.
       *
       * DUAS camadas, ambas obrigatórias:
       *   1. TOKEN — custom claim `eventos: { [eventoId]: papel }`, gravado
       *      SÓ pela Function `setClaimsEquipe` (merge preservador; cliente
       *      nunca escreve claim — RN-401). Claim de OUTRO evento/tenant não
       *      entra: a chave consultada é o eventoId DESTE match.
       *   2. ÂNCORA — doc `equipe/{uid}` (docId = uid, convenção da Function)
       *      precisa estar `status == 'ativo'` e com o MESMO papel do claim.
       *      Fecha a janela do token velho (~1h até expirar): remoção/troca
       *      de papel atualiza o doc na MESMA operação que revoga as claims,
       *      então o token antigo morre AQUI, não na expiração. Doc ausente
       *      (ou convite 'convidado' forjado no docId do uid — que nasce sem
       *      poder de âncora porque create de cliente exige status
       *      'convidado') ⇒ get() falha/compara falso ⇒ DENY. Erros são
       *      absorvidos pelo || externo — fail-closed.
       *
       * A lista `papeis` de cada coleção ESPELHA a matriz 4×7 `podeAcessar`
       * de @leela/core (fonte única) — mudar célula lá exige mudar aqui + teste.
       */
      function papelEventoAtivo(papeis) {
        return isSignedIn()
          && ('eventos' in request.auth.token)
          && (eventoId in request.auth.token.eventos)
          && (request.auth.token.eventos[eventoId] in papeis)
          && get(/databases/$(database)/documents/eventos/$(eventoId)/equipe/$(request.auth.uid))
              .data.status == 'ativo'
          && get(/databases/$(database)/documents/eventos/$(eventoId)/equipe/$(request.auth.uid))
              .data.papel == request.auth.token.eventos[eventoId];
      }

      // `inscritos/{inscritoId}` — join Atleta↔Evento (E03 · S203-T1).
      //
      // Shape (RN-202/203/204): kit e status dentro dos enums; chipNumero
      // string|null (null até a entrega). Carimbos de operação
      // (kitEntregueEm/checkinEm/qrToken/ingressoEmitidoEm) são de escrita
      // EXCLUSIVA de Function (RN-205/221/222) — cliente nunca escreve.
      // `kitId` (id EXATO do kit cobrado — fulfillment E12) idem: escrito SÓ
      // pela Function do checkout e imutável depois (cliente nem cria nem
      // atualiza — ver semCamposDeFunctionInscrito/camposDeFunctionIntocados).
      // TODO(E04/E12): atleta dono lê a própria inscrição só na story do
      // checkout, com teste (mesmo gate do TODO de leitura pública acima).
      match /inscritos/{inscritoId} {

        /** Kit dentro do enum canônico (RN-202; "kit", nunca "tier" — RN-216). */
        function kitInscritoValido() {
          return request.resource.data.kit in ['kit_ouro', 'kit_prata', 'kit_basico', 'sem_kit'];
        }

        /**
         * Status dentro do enum de CLIENTE (RN-204). 'estornado' (RN-341 ·
         * FABLE-B) fica DELIBERADAMENTE fora: é status de escrita EXCLUSIVA
         * da Function `estornarInscricao` (Admin SDK bypassa Rules) — cliente
         * não forja estorno sem devolução de dinheiro. Esta função valida o
         * estado NOVO; o congelamento do doc JÁ estornado (anti-ressurreição)
         * é de `inscritoNaoEstornado()`, que guarda pelo estado ATUAL.
         */
        function statusInscritoValido() {
          return request.resource.data.status in ['confirmado', 'pendente', 'cancelado'];
        }

        /**
         * chipNumero no CREATE: ausente ou null — o vínculo é escrita
         * EXCLUSIVA da Function `vincularChip` (RN-203/206; S204-T2). Sem
         * isso a detecção de conflito seria contornável por escrita direta.
         */
        function chipNuloNoCreate() {
          return !('chipNumero' in request.resource.data)
            || request.resource.data.chipNumero == null;
        }

        /**
         * Cliente não CRIA doc já carimbado com campos de Function.
         * `kitId` incluso (follow-up review kit E12): é o id do kit COBRADO,
         * gravado pela Function do checkout junto com o rótulo derivado —
         * espelha o padrão dos campos financeiros `[pag]` (pedidoRef etc.).
         */
        function semCamposDeFunctionInscrito() {
          return !request.resource.data.keys().hasAny(
            ['kitEntregueEm', 'checkinEm', 'qrToken', 'ingressoEmitidoEm',
             'pedidoRef', 'ehResponsavel', 'dadosPessoais', 'tamanhos', 'kitId',
             'estornadoEm', 'titularHistorico', 'pessoaRef']
          );
        }

        /**
         * Update de cliente não TOCA campos de Function (RN-205/206/221/222).
         * `chipNumero` incluso (S204-T2): nem para setar, nem para limpar.
         * `kitId` incluso (follow-up review kit E12): IMUTÁVEL após a criação
         * pela Function — adulterá-lo trocaria o kit a entregar no balcão sem
         * mudar o valor pago (fraude de fulfillment). Nem setar, nem limpar.
         */
        /**
         * S904-T4 (review antagonista H1): `atletaNome`/`atletaId`/`modalidade`
         * IMUTÁVEIS para cliente após a criação — sem isso, escrita direta de
         * owner burlaria a máquina de transferência inteira (renomear titular
         * pós-chip corrompe resultado — objeção A5; trilha titularHistorico
         * mentiria; taxa RN-343 evadida) e trocar `modalidade` fora do
         * checkout corromperia vendidos/capacidade por lote (RN-300/304).
         * Mudança de titular = SÓ requestTransfer; de percurso = SÓ checkout.
         */
        function camposDeFunctionIntocados() {
          return !request.resource.data.diff(resource.data).affectedKeys().hasAny(
            ['kitEntregueEm', 'checkinEm', 'qrToken', 'ingressoEmitidoEm', 'chipNumero',
             'pedidoRef', 'ehResponsavel', 'dadosPessoais', 'tamanhos', 'kitId',
             'estornadoEm', 'titularHistorico', 'atletaNome', 'atletaId', 'modalidade',
             'pessoaRef']
          );
        }

        /**
         * Doc estornado é CONGELADO para cliente (RN-341 · FABLE-B): guarda
         * pelo estado ATUAL (resource), não pelo novo — sem ela, um update
         * com `status: 'confirmado'` passaria em statusInscritoValido (que
         * valida o estado NOVO) e RESSUSCITARIA uma inscrição cujo dinheiro
         * já foi devolvido (achado do teste adversarial FABLE-B). Vale
         * também para delete: apagar+recriar limparia a marca do estorno.
         * Ajuste pós-estorno é superfície de Function/platform_admin.
         */
        function inscritoNaoEstornado() {
          return resource.data.status != 'estornado';
        }

        // LEITURA restrita a papel de GESTÃO (owner/staff via isTenantWriter),
        // NÃO a qualquer membro do tenant (fix PII/LGPD — revisão r1). O doc do
        // inscrito carrega PII + dado SENSÍVEL de saúde (dadosPessoais.{cpf,
        // telefone, restricoesMedicas} — ADR-011/A-T2). promoter e um token
        // `role:'athlete'` com tenantId do claim NÃO leem CPF/telefone/saúde —
        // só organizador (owner/staff) e platform_admin. Espelha a taxonomia de
        // `pedidos`/`pagamentos`, que já exigem isTenantWriter para o financeiro.
        // S304-T1 (matriz `inscritos`): equipe do evento com papel organizador/
        // administrador/operador TAMBÉM lê — o operador de balcão atende o
        // atleta pelo doc do inscrito (E03-S204). `financeiro` NÃO (célula
        // false — dinheiro sim, PII de inscrito não). ESCRITA de cliente segue
        // isTenantWriter (disciplina herdada — papel de evento não escreve PII;
        // entrega/chip/check-in do operador passam pelas Functions do balcão).
        allow read: if isPlatformAdmin()
                    || isTenantWriter(tenantDoEventoPai())
                    || papelEventoAtivo(['organizador', 'administrador', 'operador']);
        allow create: if (isTenantWriter(request.resource.data.tenantId)
                          && request.resource.data.tenantId == tenantDoEventoPai()
                          && tenantAtivo(request.resource.data.tenantId)
                          && kitInscritoValido()
                          && statusInscritoValido()
                          && chipNuloNoCreate()
                          && semCamposDeFunctionInscrito())
                      || isPlatformAdmin();
        allow update: if (isTenantWriter(resource.data.tenantId)
                          && request.resource.data.tenantId == resource.data.tenantId
                          && tenantAtivo(resource.data.tenantId)
                          && kitInscritoValido()
                          && statusInscritoValido()
                          && inscritoNaoEstornado()
                          && camposDeFunctionIntocados())
                      || isPlatformAdmin();
        allow delete: if (isTenantWriter(resource.data.tenantId)
                          && tenantAtivo(resource.data.tenantId)
                          && inscritoNaoEstornado())
                      || isPlatformAdmin();

        // `saude/{current}` — dado de SAÚDE do inscrito (S306 · RN-147 ·
        // LGPD Art. 11). Subcoleção SENSÍVEL isolada: base legal
        // (consentimento destacado), acesso e retenção próprios.
        // LEITURA: owner/staff do tenant + papel de evento organizador/
        // administrador + platform_admin — OPERADOR fica FORA (o balcão não
        // precisa de PAR-Q/atestado; a superfície é MENOR que a do doc do
        // inscrito), e afiliado/patrocinador/promoter/athlete/financeiro
        // NEGADOS (RN-147). ESCRITA de cliente: NUNCA — a coleta é da
        // Function do checkout (E12-S1207/E13) e o EXPURGO é do cron
        // expurgarSaude (ambos Admin SDK). Sem match de subcoleções de
        // inscritos = deny-by-default; este match EXISTE para abrir a
        // leitura de gestão e documentar a negação.
        match /saude/{saudeDocId} {
          allow read: if isPlatformAdmin()
                      || isTenantWriter(tenantDoEventoPai())
                      || papelEventoAtivo(['organizador', 'administrador']);
          allow write: if false;
        }
      }

      // `kits/{kitId}` — kits do evento (E03 · S205-T1).
      //
      // RN-210: 0..N kits por evento. RN-211: "Sem kit" é kit válido e o
      // preço ACEITA NEGATIVO (desconto) — shape exige number, sem piso.
      // RN-216: o campo/conceito é "kit" — "tier" não existe no produto.
      //
      // RN-200 (fix review Onda1 #04): com venda no evento pai, a ESTRUTURA
      // de kits congela para o cliente — create e delete negados, update só
      // sem tocar `preco`. Sem isso o bloqueio de preço era anulável em 2
      // chamadas (delete + recreate com preço novo). Espelha a semântica de
      // `percursosEditaveis` (o array congela inteiro após a 1ª venda).
      // Ajustes legítimos pós-venda são superfície de Function/platform_admin.
      match /kits/{kitId} {

        /** Shape mínimo do kit (nome não-vazio; preco number, negativo ok). */
        function shapeKitValido() {
          return request.resource.data.nome is string
            && request.resource.data.nome.size() > 0
            && request.resource.data.preco is number
            && request.resource.data.capacidade is number
            && request.resource.data.modalidades is list
            && camposVisaoKitValidos();
        }

        /**
         * R9-C (RN-227/RN-229) — visão de compra do kit, TODOS opcionais
         * (doc legado segue válido):
         *   - `descricao` ≤ 280 (teto KIT_DESCRICAO_MAX do core);
         *   - `itens` lista ≤ 30 entradas (tipo dos ELEMENTOS não é
         *     verificável em Rules sem iteração — o parse do core descarta
         *     não-string; limitação honesta, mesma do resto do arquivo);
         *   - `imagemUrl` null ou http(s) ≤ 2048 (ESPELHO de capaValida do
         *     evento — a URL vira `src` de <img> na landing pública;
         *     javascript:/data: nunca entram no doc).
         */
        function camposVisaoKitValidos() {
          return (!('descricao' in request.resource.data)
              || request.resource.data.descricao == null
              || (request.resource.data.descricao is string
                  && request.resource.data.descricao.size() <= 280))
            && (!('itens' in request.resource.data)
              || (request.resource.data.itens is list
                  && request.resource.data.itens.size() <= 30))
            && (!('imagemUrl' in request.resource.data)
              || request.resource.data.imagemUrl == null
              || (request.resource.data.imagemUrl is string
                  && request.resource.data.imagemUrl.size() <= 2048
                  && request.resource.data.imagemUrl.matches('https?://.*')));
        }

        /**
         * RN-200 (S201-T3): evento COM venda ⇒ cliente não muda `preco` do
         * kit. Outros campos seguem editáveis; sem venda, preço livre
         * (inclusive mais negativo no "Sem kit" — RN-211 preservada).
         */
        function precoEditavel() {
          return !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['preco'])
            || !eventoPaiTemVenda();
        }

        // S304-T1 (matriz `entrega`/`pagina_vendas`): equipe organizador/
        // administrador/operador lê kits — o operador precisa do kit p/
        // entregar no balcão; `financeiro` não (células false).
        allow read: if isPlatformAdmin()
                    || isTenantMember(tenantDoEventoPai())
                    || papelEventoAtivo(['organizador', 'administrador', 'operador']);
        allow create: if (isTenantWriter(request.resource.data.tenantId)
                          && request.resource.data.tenantId == tenantDoEventoPai()
                          && tenantAtivo(request.resource.data.tenantId)
                          && shapeKitValido()
                          && !eventoPaiTemVenda())
                      || isPlatformAdmin();
        allow update: if (isTenantWriter(resource.data.tenantId)
                          && request.resource.data.tenantId == resource.data.tenantId
                          && tenantAtivo(resource.data.tenantId)
                          && shapeKitValido()
                          && precoEditavel())
                      || isPlatformAdmin();
        allow delete: if (isTenantWriter(resource.data.tenantId)
                          && tenantAtivo(resource.data.tenantId)
                          && !eventoPaiTemVenda())
                      || isPlatformAdmin();
      }

      // `lotes/{loteId}` — kernel de vendas (E04 · S300-T1 · ADR-012).
      //
      // O LOTE PERTENCE À MODALIDADE (ADR-012): subcoleção flat com
      // `modalidade` discriminador (idioma de evento.modalidades[]/
      // inscrito.modalidade); a lista ordenada da modalidade é a query
      // `where modalidade == X orderBy ordem`. Fronteira Firestore (Kleppmann,
      // S300-T1-REPORT): doc próprio porque `vendidos` é contador de escrita de
      // alta frequência (Function de virada, S300-T2) — increment single-object
      // isolado, não reescrita de doc gordo do evento.
      //
      // `vendidos` = ∑ de escrita EXCLUSIVA de Function: create exige 0/ausente,
      // update não o toca. RN-300/200 (registrado): preço/janela/vaga/ordem/
      // modalidade CONGELAM após a 1ª venda DO PRÓPRIO LOTE (vendidos > 0) — a
      // trava é per-lote (granularidade ADR-012 (modalidade, lote)), mais
      // precisa que o ∑ do evento; espelha a semântica de `percursosEditaveis`.
      // Leitura PÚBLICA do preço no checkout fica para a story de compra
      // (E12/S300 checkout), com teste — deny-by-default até lá (precedente do
      // TODO de leitura pública de eventos). Aqui: membro do tenant lê.
      match /lotes/{loteId} {

        /** Shape do lote (ADR-012 · RN-300/301) — janela/vaga/preço coerentes.
            `preco` cent-exato e finito (re-review S300 #6 — espelha o core). */
        function shapeLoteValido() {
          return request.resource.data.modalidade is string
            && request.resource.data.modalidade.size() > 0
            && request.resource.data.nome is string
            && request.resource.data.nome.size() > 0
            && request.resource.data.ordem is int
            && request.resource.data.ordem >= 1
            && request.resource.data.quantidadeLimite is int
            && request.resource.data.quantidadeLimite >= 1
            && moneyCentExato(request.resource.data.preco)
            && request.resource.data.preco >= 0
            && request.resource.data.inicioEm is timestamp
            && request.resource.data.fimEm is timestamp
            && request.resource.data.fimEm > request.resource.data.inicioEm;
        }

        /**
         * ADR-012 (re-review S300 #4-rules): o lote referencia uma modalidade
         * EXISTENTE de `evento.modalidades` — sem isto o cliente criaria um
         * degrau de preço para modalidade fantasma ('99k') que nenhum
         * percurso/inscrito conhece.
         */
        function modalidadeExisteNoEventoPai() {
          return request.resource.data.modalidade
            in get(/databases/$(database)/documents/eventos/$(eventoId)).data.get('modalidades', []);
        }

        /** `vendidos` (∑ de Function) nasce 0/ausente — cliente nunca inventa venda. */
        function vendidosZeradoNoCreate() {
          return request.resource.data.get('vendidos', 0) == 0;
        }

        /** Update de cliente não TOCA `vendidos` (só a Function de virada). */
        function vendidosIntocado() {
          return !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['vendidos']);
        }

        /**
         * Carimbos de VIRADA (`encerradoEm`/`encerradoMotivo` — S300-T2)
         * nascem AUSENTES: cliente não cria lote pré-encerrado (forjaria a
         * trilha RN-300 e a UI de status).
         */
        function viradaZeradaNoCreate() {
          return !('encerradoEm' in request.resource.data)
            && !('encerradoMotivo' in request.resource.data)
            // Carimbo do ajuste de capacidade (S307) também não nasce de
            // cliente (review antagonista O3-L1 #2).
            && !('capacidadeAjustadaEm' in request.resource.data);
        }

        /** Update de cliente não TOCA os carimbos de virada (só a Function
            de S300-T2 encerra/carimba — espelha CAMPOS_FUNCTION_LOTE). */
        function viradaIntocada() {
          // `capacidadeAjustadaEm` incluso (review antagonista O3-L1 #2):
          // carimbo do ajuste de capacidade (S307) é escrita EXCLUSIVA da
          // Function `ajustarCapacidadeLote` — cliente forjando o carimbo
          // fabricaria trilha de ajuste que não houve.
          return !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['encerradoEm', 'encerradoMotivo', 'capacidadeAjustadaEm']);
        }

        /**
         * Lote com venda (vendidos > 0) CONGELA os campos comerciais para o
         * cliente (RN-200/300 na granularidade (modalidade, lote) — ADR-012).
         * Sem venda, tudo editável. Ajustes pós-venda = Function/platform_admin.
         */
        function loteComercialImutavelSeVendido() {
          return resource.data.get('vendidos', 0) == 0
            || !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['preco', 'inicioEm', 'fimEm', 'quantidadeLimite',
                         'ordem', 'modalidade']);
        }

        // S304-T1 (matriz `pagina_vendas`): equipe organizador/administrador
        // lê lotes; operador/financeiro não (células false).
        allow read: if isPlatformAdmin()
                    || isTenantMember(tenantDoEventoPai())
                    || papelEventoAtivo(['organizador', 'administrador']);
        allow create: if (isTenantWriter(request.resource.data.tenantId)
                          && request.resource.data.tenantId == tenantDoEventoPai()
                          && tenantAtivo(request.resource.data.tenantId)
                          && shapeLoteValido()
                          && modalidadeExisteNoEventoPai()
                          && vendidosZeradoNoCreate()
                          && viradaZeradaNoCreate())
                      || isPlatformAdmin();
        allow update: if (isTenantWriter(resource.data.tenantId)
                          && request.resource.data.tenantId == resource.data.tenantId
                          && tenantAtivo(resource.data.tenantId)
                          && shapeLoteValido()
                          && modalidadeExisteNoEventoPai()
                          && vendidosIntocado()
                          && viradaIntocada()
                          && loteComercialImutavelSeVendido())
                      || isPlatformAdmin();
        allow delete: if (isTenantWriter(resource.data.tenantId)
                          && tenantAtivo(resource.data.tenantId)
                          && resource.data.get('vendidos', 0) == 0)
                      || isPlatformAdmin();
      }

      // `cupons/{cupomId}` — kernel de vendas (E04 · S300-T1).
      //
      // docId = código NORMALIZADO (unicidade por chave — "código duplicado é
      // rejeitado" vira colisão de docId; recriar o mesmo código cai no update,
      // que trava `codigo` imutável). Sem query de duplicidade.
      //
      // LEITURA SENSÍVEL: código de cupom é ativo comercial — só o ORGANIZADOR
      // (writer) lê, NUNCA membro genérico (promoter/athlete). Por isso o
      // catch-all abaixo EXCLUI `cupons` (mesma lição de `inscritos` em A-T2:
      // regra específica restrita + catch-all re-concedendo = vazamento). No
      // checkout o cupom é VALIDADO por Function (aplicar código), não lido por
      // enumeração da coleção.
      //
      // `usos` = ∑ de escrita EXCLUSIVA de Function (checkout): create 0/ausente,
      // update não o toca.
      match /cupons/{cupomId} {

        /** Shape do cupom — tipo/valor coerentes; docId == codigo; janela válida. */
        function shapeCupomValido() {
          return request.resource.data.codigo is string
            && request.resource.data.codigo == cupomId
            // Espelha CODIGO_CUPOM_RE do core: sem isto o cliente grava um
            // docId/codigo minúsculo/acentuado que o checkout (lookup UPPER)
            // nunca acha → cupom morto persistível (review antagonista A4).
            && request.resource.data.codigo.matches('^[A-Z0-9]{3,20}$')
            && request.resource.data.tipo in ['percentual', 'fixo']
            // cent-exato e finito (re-review S300 #6): `valor > 0` sozinho
            // aceitava Infinity no tipo fixo e sub-centavo em desconto.
            && moneyCentExato(request.resource.data.valor)
            && request.resource.data.valor > 0
            && (request.resource.data.tipo != 'percentual'
                || request.resource.data.valor <= 100)
            && (!('tetoUso' in request.resource.data)
                || request.resource.data.tetoUso == null
                || (request.resource.data.tetoUso is int
                    && request.resource.data.tetoUso >= 1))
            && request.resource.data.inicioEm is timestamp
            && request.resource.data.fimEm is timestamp
            && request.resource.data.fimEm > request.resource.data.inicioEm
            // Escopo (RN-364 · E18): o canal de CLIENTE só grava cupom
            // 'geral' (ausente == geral). Cupom 'club_parceiro' + a
            // amarração clubeRef/parceriaRef nascem SÓ pela Function
            // `definirCondicaoDesconto` (kernel + carimbo na parceria na
            // MESMA tx — ADR-012: nenhum segundo caminho de desconto).
            && request.resource.data.get('escopo', 'geral') == 'geral'
            // `afiliadoRef` (R9-E · RN-315/316): amarração cupom↔afiliado é
            // de Function (`salvarAfiliado`, tx dupla) — cliente nunca a
            // cria (senão inventaria gate de desconto sem dono real).
            && !request.resource.data.keys().hasAny(['clubeRef', 'parceriaRef', 'afiliadoRef']);
        }

        /** `usos` (∑ de Function) nasce 0/ausente. */
        function usosZeradoNoCreate() {
          return request.resource.data.get('usos', 0) == 0;
        }

        /** Update de cliente não TOCA `usos` nem `codigo` (chave/∑ imutáveis).
            Nem o escopo/amarração E18 (RN-364): de-escopar um cupom
            'club_parceiro' pelo cliente reviveria o desconto sem a guarda
            de parceria ATIVA e órfãnaria a condicaoDesconto. Nem o
            `afiliadoRef` (R9-E · RN-315): des-amarrar pelo cliente
            destravaria o desconto ANTES do mínimo de inscrições. */
        function usosECodigoIntocados() {
          return !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['usos', 'escopo', 'clubeRef', 'parceriaRef', 'afiliadoRef'])
            && request.resource.data.codigo == resource.data.codigo;
        }

        // S304-T1 (matriz `pagina_vendas`): equipe organizador/administrador
        // lê cupons (administrador gere a página de vendas — épico E04);
        // operador/financeiro NÃO (célula false — código de cupom é ativo
        // comercial, mesma lição do catch-all).
        allow read: if isPlatformAdmin()
                    || isTenantWriter(tenantDoEventoPai())
                    || papelEventoAtivo(['organizador', 'administrador']);
        allow create: if (isTenantWriter(request.resource.data.tenantId)
                          && request.resource.data.tenantId == tenantDoEventoPai()
                          && tenantAtivo(request.resource.data.tenantId)
                          && shapeCupomValido()
                          && usosZeradoNoCreate())
                      || isPlatformAdmin();
        allow update: if (isTenantWriter(resource.data.tenantId)
                          && request.resource.data.tenantId == resource.data.tenantId
                          && tenantAtivo(resource.data.tenantId)
                          && shapeCupomValido()
                          && usosECodigoIntocados())
                      || isPlatformAdmin();
        // Delete SÓ sem uso (re-review S300 #3 — espelha o delete de lote):
        // cupom com `usos > 0` é trilha comercial de desconto aplicado; sumir
        // com ele órfãnaria a auditoria do checkout. Remoção real = Function.
        // Cupom 'club_parceiro' NUNCA some pelo cliente (órfãnaria a
        // condicaoDesconto da parceria — o ciclo dele é da Function E18).
        // Cupom AMARRADO a afiliado (R9-E) também não some pelo cliente —
        // órfãnaria `afiliado.cupomCodigo` (desamarrar = Function).
        allow delete: if (isTenantWriter(resource.data.tenantId)
                          && tenantAtivo(resource.data.tenantId)
                          && resource.data.get('usos', 0) == 0
                          && resource.data.get('escopo', 'geral') == 'geral'
                          && resource.data.get('afiliadoRef', '') == '')
                      || isPlatformAdmin();
      }

      // `paginaVendas/{docId}` — config da página de vendas (E04 · S300-T1).
      //
      // 1 doc por evento (docId = 'config'). Seções por canal + SEO. Invariante:
      // seção 'checkout' sempre travada+ativa (validada no core; a Rule trava o
      // shape-list). PUBLICAÇÃO (`publicada`/`publicadaEm`) = carimbo de escrita
      // EXCLUSIVA de Function (S300-T3 valida completude server-side, como
      // publicarEvento): create exige publicada false/ausente, update não a toca.
      // Cliente edita seções/SEO. Leitura pública da página publicada = story do
      // checkout/landing (deny-by-default até lá); aqui membro do tenant lê.
      match /paginaVendas/{docId} {

        /** Shape-list mínimo (o invariante checkout-travado vive no core). */
        function shapePaginaValida() {
          return request.resource.data.secoes is list
            && request.resource.data.seo is map
            && request.resource.data.seo.titulo is string
            && request.resource.data.seo.slugAmigavel is string
            && request.resource.data.eventoId is string
            && request.resource.data.eventoId == eventoId;
        }

        /** Publicação nasce desligada — publicar é escrita de Function. */
        function publicacaoZeradaNoCreate() {
          return request.resource.data.get('publicada', false) == false
            && !('publicadaEm' in request.resource.data);
        }

        /** Update de cliente não TOCA os carimbos de publicação (só Function). */
        function publicacaoIntocada() {
          return !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['publicada', 'publicadaEm']);
        }

        // S304-T1 (matriz `pagina_vendas`): equipe organizador/administrador
        // lê; operador/financeiro NÃO (aceite E04-L4: financeiro em página
        // de vendas → nega — e a ESCRITA segue isTenantWriter p/ todos).
        allow read: if isPlatformAdmin()
                    || isTenantMember(tenantDoEventoPai())
                    || papelEventoAtivo(['organizador', 'administrador']);
        // Create SÓ no docId canônico `config` (re-review S300 #5): "1 doc
        // por evento" era só comentário — um segundo doc ('config2') criaria
        // página fantasma fora do caminho que a vitrine/Function leem.
        allow create: if (isTenantWriter(request.resource.data.tenantId)
                          && docId == 'config'
                          && request.resource.data.tenantId == tenantDoEventoPai()
                          && tenantAtivo(request.resource.data.tenantId)
                          && shapePaginaValida()
                          && publicacaoZeradaNoCreate())
                      || isPlatformAdmin();
        allow update: if (isTenantWriter(resource.data.tenantId)
                          && request.resource.data.tenantId == resource.data.tenantId
                          && tenantAtivo(resource.data.tenantId)
                          && shapePaginaValida()
                          && publicacaoIntocada())
                      || isPlatformAdmin();
        // Config da página não é deletada por cliente (trilha da vitrine).
        allow delete: if isPlatformAdmin();
      }

      // `financeiro/{docId}` — agregado financeiro do evento (E03 · S207-T2).
      //
      // `current` carrega receitaBruta/taxaValor/receitaLiquida — o REPASSE
      // do organizador. Dinheiro segue a taxonomia de `pedidos`/`pagamentos`
      // (papel de GESTÃO): leitura SÓ writer (owner/staff) e platform_admin;
      // promoter e athlete-com-claim NÃO leem (re-review Fable A-T2 A1: sem
      // este match o doc caía no catch-all de MEMBRO e vazava o repasse).
      // Escrita: NUNCA pelo cliente — o doc é recomputado exclusivamente pela
      // Function `agregarFinanceiro` (Admin SDK bypassa Rules).
      // S304-T1 (matriz `financeiro` — aceite E04-L4): equipe com papel
      // organizador/financeiro lê o repasse; administrador e OPERADOR são
      // célula FALSE (operador lendo financeiro → Rule NEGA). Escrita de
      // cliente segue NUNCA — papel de evento não muda isso (regressão).
      match /financeiro/{docId} {
        allow read: if isPlatformAdmin()
                    || isTenantWriter(tenantDoEventoPai())
                    || papelEventoAtivo(['organizador', 'financeiro']);
        allow write: if false;
      }

      // `demografia/{docId}` — agregado DEMOGRÁFICO do evento (E11 §RN-820 ·
      // LEELA-BEPEND-T1). `current` = SÓ contagens por bucket (faixa etária ×
      // gênero) — nenhum dado individual (a fronteira LGPD é a Function
      // `agregarDemografia`, que lê o [reg] server-side e materializa buckets).
      // Mesmo assim o perfil agregado dos compradores é inteligência de
      // GESTÃO: leitura SÓ writer (owner/staff) e platform_admin — promoter,
      // athlete-com-claim e papel de evento NÃO leem (match explícito: a
      // subcoleção NÃO entra na allowlist do catch-all — herança Wave A).
      // Escrita: NUNCA pelo cliente — recompute exclusivo da Function
      // (contagem forjada = perfil de público fraudado na análise).
      match /demografia/{docId} {
        allow read: if isPlatformAdmin()
                    || isTenantWriter(tenantDoEventoPai());
        allow write: if false;
      }

      // `reembolsos/{inscritoId}` — máquina de reembolso (E09 · S904-T1/T2 ·
      // RN-341). docId = inscritoId (um reembolso ativo por inscrito, ADR-011).
      // O doc revela movimento de DINHEIRO e a fila de análise do organizador —
      // leitura de GESTÃO: owner/staff, platform_admin e papel de evento
      // organizador/financeiro (a fila vive na aba financeira). ESCRITA de
      // estado/dinheiro: NUNCA pelo cliente — exclusiva das Functions
      // requestRefund/decideRefund (Admin SDK bypassa Rules). Athlete dono da
      // inscrição só lê o próprio reembolso quando o app do atleta aterrissar
      // (E13-S1315 — self-service); até lá deny-by-default para athlete.
      match /reembolsos/{inscritoId} {
        allow read: if isPlatformAdmin()
                    || isTenantWriter(tenantDoEventoPai())
                    || papelEventoAtivo(['organizador', 'financeiro']);
        allow write: if false;
      }

      // `transferencias/{transferenciaId}` — transferência de titularidade /
      // troca de ingresso (E09 · S904-T4 · RN-343/344/345). O doc carrega PII
      // do novo titular (`novoTitular.dadosPessoais`) e valor a cobrar —
      // MESMA superfície de leitura dos reembolsos (gestão). ESCRITA: NUNCA
      // pelo cliente — exclusiva da Function `requestTransfer` (Admin SDK);
      // forjar transferência trocaria quem corre/retira kit sem as guardas
      // de kit/chip/janela. Self-service do atleta é E13-S1316 (deny até lá).
      match /transferencias/{transferenciaId} {
        allow read: if isPlatformAdmin()
                    || isTenantWriter(tenantDoEventoPai())
                    || papelEventoAtivo(['organizador', 'financeiro']);
        allow write: if false;
      }

      // `comunicacoes/{comunicacaoId}` — LOG DE COMUNICAÇÃO (FABLE-G-T1).
      //
      // Agregado ÚNICO: fonte de E06-L3 (aba Comunicação/campanhas) e de
      // S1206-T2 (log de envio do ingresso — RN-219). Cada doc registra UM
      // envio (e-mail/push) a UM destinatário, com status de entrega/
      // abertura e carimbos.
      //
      // PII (LGPD): o log revela A QUEM se comunicou e SE abriu — leitura
      // segue a taxonomia de `inscritos`/`pedidos`/`financeiro` (papel de
      // GESTÃO): SÓ owner/staff do tenant dono e platform_admin; promoter e
      // athlete-com-claim NÃO leem. O doc NÃO carrega corpo de mensagem
      // (parseLogComunicacao rejeita — PII mínima).
      //
      // ESCRITA: NUNCA pelo cliente — o envio é server-side e o status vem
      // de webhook de provider; escreve SÓ a Function (Admin SDK bypassa
      // Rules). O docId é DETERMINÍSTICO ({destinatario}_{chave}_{canal}):
      // a idempotência de envio (RN-219) mora na colisão de docId — por
      // isso nenhum cliente cria/atualiza/deleta (forjar um doc suprimiria
      // um envio devido; alterar status fabricaria abertura que não houve).
      // S304-T1 (matriz `comunicacao`): equipe organizador/administrador lê
      // o log (a aba Comunicação é gestão de conteúdo — E06); operador/
      // financeiro NÃO (células false — o log é PII de destinatário).
      match /comunicacoes/{comunicacaoId} {
        allow read: if isPlatformAdmin()
                    || isTenantWriter(tenantDoEventoPai())
                    || papelEventoAtivo(['organizador', 'administrador']);
        allow write: if false;
      }

      // `comunicacoesResumo/{docId}` — agregado ∑ do log (FABLE-G-T1).
      // `current` = contagens por status/canal/tipo recomputadas
      // INTEGRALMENTE pela Function `agregarComunicacoes` (padrão
      // `financeiro/current`). Mesma taxonomia de leitura do log; escrita
      // de cliente NUNCA (contagem forjada = histórico de comunicação
      // fraudado na aba do evento).
      match /comunicacoesResumo/{docId} {
        allow read: if isPlatformAdmin()
                    || isTenantWriter(tenantDoEventoPai())
                    || papelEventoAtivo(['organizador', 'administrador']);
        allow write: if false;
      }

      // `campanhas/{campanhaId}` — comunicação segmentada do EVENTO
      // (E06 · S401-T1). Espelha o bloco `comunicados` do clube (L1365) com
      // a taxonomia do evento e os MESMOS códigos de status compartilhados
      // (decisão item 9 do brief E06: rascunho/agendado/enviado — um literal
      // nos dois lados; "Enviada/Agendada" é rótulo de UI).
      //
      // RN-130: cliente cria/edita APENAS rascunho/agendado — o carimbo
      // 'enviado' (+ enviadoEm/alcance) é EXCLUSIVO da Function
      // `enviarCampanha` (S401-T4, que também valida o limite RN-133).
      // Campanha enviada é imutável e indeletável para o cliente (trilha).
      // RN-131/132: canal 1..2 dentro do enum; origem no enum.
      // RN-135: imagem de capa só existe quando o canal inclui email.
      // Corte 5 (brief E06): SEM 'por_engajamento' no enum de segmento —
      // taxonomia V1 = todos_inscritos|por_modalidade|por_kit|por_status.
      // Corte 4: `aberturasPct` fora do modelo V1, mas SEGUE na deny-list
      // (cliente que tentar gravá-lo é negado hoje e pós-provider).
      // Leitura: matriz S304 área `comunicacao` — tenant member + equipe
      // organizador/administrador (operador/financeiro = célula false).
      match /campanhas/{campanhaId} {

        /** Shape básico (RN-131/132 + segmento do evento + RN-135) + espelho
            mínimo de título/conteúdo (SPEC-02: ≥5/≥10 após trim). Segmento
            fora de 'todos_inscritos' exige `referencia` (o enum fino de
            kit/status é validado no core — validarSegmentoCampanha). */
        function shapeCampanhaValida() {
          return request.resource.data.canal is list
            && request.resource.data.canal.size() >= 1
            && request.resource.data.canal.size() <= 2
            && request.resource.data.canal.hasOnly(['push', 'email'])
            && request.resource.data.origem in ['manual', 'automatizada']
            && request.resource.data.segmento.tipo in
                ['todos_inscritos', 'por_modalidade', 'por_kit', 'por_status']
            && (request.resource.data.segmento.tipo == 'todos_inscritos'
                || (('referencia' in request.resource.data.segmento)
                    && request.resource.data.segmento.referencia is string
                    && request.resource.data.segmento.referencia.size() > 0))
            && (!('capaUrl' in request.resource.data)
                || 'email' in request.resource.data.canal)
            && request.resource.data.titulo is string
            && request.resource.data.titulo.trim().size() >= 5
            && request.resource.data.conteudo is string
            && request.resource.data.conteudo.trim().size() >= 10;
        }

        /** 'agendado' exige `agendadoPara` timestamp (o cron é Onda 3, mas
            o invariante nasce garantido — espelho do clube S6a). */
        function agendamentoCampanhaCoerente() {
          return request.resource.data.status != 'agendado'
            || (('agendadoPara' in request.resource.data)
                && request.resource.data.agendadoPara is timestamp);
        }

        /** Cliente nunca escreve status 'enviado' (RN-130) nem 'vencido'
            (RN-136 — decisão 17: estado TERMINAL, exclusivo do cron). */
        function statusCampanhaEditavelPeloCliente() {
          return request.resource.data.status in ['rascunho', 'agendado'];
        }

        /** Cliente não CRIA doc carimbado com campos da Function de envio
            nem com o carimbo de vencimento (RN-136). */
        function semCamposDeEnvioCampanha() {
          return !request.resource.data.keys()
              .hasAny(['enviadoEm', 'aberturasPct', 'vencidoEm'])
            && request.resource.data.get('alcance', 0) == 0;
        }

        /** Update de cliente não TOCA campos de Function (envio/vencimento). */
        function camposDeEnvioCampanhaIntocados() {
          return !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['alcance', 'aberturasPct', 'enviadoEm', 'vencidoEm']);
        }

        allow read: if isPlatformAdmin()
                    || isTenantMember(tenantDoEventoPai())
                    || papelEventoAtivo(['organizador', 'administrador']);
        allow create: if (isTenantWriter(request.resource.data.tenantId)
                          && request.resource.data.tenantId == tenantDoEventoPai()
                          && tenantAtivo(request.resource.data.tenantId)
                          && shapeCampanhaValida()
                          && agendamentoCampanhaCoerente()
                          && statusCampanhaEditavelPeloCliente()
                          && semCamposDeEnvioCampanha())
                      || isPlatformAdmin();
        // 'enviado' é trilha imutável; 'vencido' (RN-136 — decisão 17) é
        // TERMINAL: cliente não edita (reviver/reagendar = decisão futura
        // do Vitor) nem deleta (o doc é a trilha de que um agendamento NÃO
        // saiu — valor de suporte).
        allow update: if (isTenantWriter(resource.data.tenantId)
                          && request.resource.data.tenantId == resource.data.tenantId
                          && tenantAtivo(resource.data.tenantId)
                          && resource.data.status != 'enviado'
                          && resource.data.status != 'vencido'
                          && shapeCampanhaValida()
                          && agendamentoCampanhaCoerente()
                          && statusCampanhaEditavelPeloCliente()
                          && camposDeEnvioCampanhaIntocados())
                      || isPlatformAdmin();
        allow delete: if (isTenantWriter(resource.data.tenantId)
                          && tenantAtivo(resource.data.tenantId)
                          && resource.data.status != 'enviado'
                          && resource.data.status != 'vencido')
                      || isPlatformAdmin();
      }

      // `automacoes/{automacaoId}` — comunicação por GATILHO (E06 · S402-T1
      // · RN-132). O cliente configura gatilho/template/canal/ativa/offset;
      // o DISPARO é exclusivo das Functions (trigger novo_inscrito + cron),
      // que reusam executarDisparoCampanha (DIRECTIVE — pipeline único).
      // ∑ `disparos` = recontagem por Function: create exige 0/ausente,
      // update não o toca (postura pós-19c8afe).
      // Leitura: mesma taxonomia de campanhas (matriz S304 área comunicacao).
      match /automacoes/{automacaoId} {

        /** Shape (enum de gatilho + template + canal RN-131 + offset). */
        function shapeAutomacaoValida() {
          return request.resource.data.gatilho in
              ['novo_inscrito', 'kit_disponivel', 'vespera_evento', 'pos_evento']
            && request.resource.data.templateRef is string
            && request.resource.data.templateRef.size() > 0
            && request.resource.data.canal is list
            && request.resource.data.canal.size() >= 1
            && request.resource.data.canal.size() <= 2
            && request.resource.data.canal.hasOnly(['push', 'email'])
            && request.resource.data.ativa is bool
            // offset SÓ nos gatilhos de relógio; teto de sanidade 720h (30d)
            && (!('offsetHoras' in request.resource.data)
                || (request.resource.data.gatilho in
                      ['vespera_evento', 'pos_evento']
                    && request.resource.data.offsetHoras is int
                    && request.resource.data.offsetHoras >= 1
                    && request.resource.data.offsetHoras <= 720));
        }

        /** ∑ `disparos` (recontagem de Function) nasce 0/ausente; o carimbo
            `vencidoEm` (RN-136 — cron desativa gatilho pontual vencido)
            NUNCA nasce do cliente. */
        function disparosZeradoNoCreate() {
          return request.resource.data.get('disparos', 0) == 0
            && !request.resource.data.keys().hasAny(['vencidoEm']);
        }

        /** Update de cliente não TOCA o ∑ nem o carimbo de vencimento.
            (Reativar `ativa=true` é permitido — o cron re-desativa sem
            disparar enquanto o momento seguir vencido; decisão 17.) */
        function disparosIntocado() {
          return !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['disparos', 'vencidoEm']);
        }

        allow read: if isPlatformAdmin()
                    || isTenantMember(tenantDoEventoPai())
                    || papelEventoAtivo(['organizador', 'administrador']);
        allow create: if (isTenantWriter(request.resource.data.tenantId)
                          && request.resource.data.tenantId == tenantDoEventoPai()
                          && tenantAtivo(request.resource.data.tenantId)
                          && shapeAutomacaoValida()
                          && disparosZeradoNoCreate())
                      || isPlatformAdmin();
        allow update: if (isTenantWriter(resource.data.tenantId)
                          && request.resource.data.tenantId == resource.data.tenantId
                          && tenantAtivo(resource.data.tenantId)
                          && shapeAutomacaoValida()
                          && disparosIntocado())
                      || isPlatformAdmin();
        // Delete: permitido ao writer — a trilha REAL do que foi enviado
        // vive no log de comunicação (RN-219), que nunca some.
        allow delete: if (isTenantWriter(resource.data.tenantId)
                          && tenantAtivo(resource.data.tenantId))
                      || isPlatformAdmin();
      }

      // `aprovisionamento/{sku}` — estoque de kit POR SKU (item tamanhado ×
      // tamanho; docId `itemId__tamanho` — S210-T2 · FABLE-D).
      //
      // ∑ (`qtdVendida`/`aEncomendar`/`alerta` — RN-224) recomputados pela
      // Function `agregarEstoque`; estado da máquina (`estado`/`estoqueFisico`
      // /`historico` — RN-226) avança SÓ pela callable
      // `transicaoAprovisionamento` (guard de organizador na Function).
      //
      // ESCRITA: NUNCA pelo cliente (Admin SDK bypassa Rules) — estoque
      // forjado = kit não encomendado = atleta sem camiseta no balcão; e a
      // matriz de transição (RN-226) só é validada dentro da Function.
      // LEITURA: taxonomia de GESTÃO (`inscritos`/`financeiro`): owner/staff
      // do tenant dono e platform_admin; promoter/athlete-com-claim NÃO leem
      // (o SKU expõe a demanda comercial do evento por tamanho). NÃO entra
      // na allowlist de membro do catch-all abaixo.
      match /aprovisionamento/{sku} {
        allow read: if isPlatformAdmin()
                    || isTenantWriter(tenantDoEventoPai());
        allow write: if false;
      }

      // `equipe/{membroId}` — equipe do evento: 4 papéis (S304-T1 · RN-320).
      //
      // O PAPEL VIVE NO TOKEN (ADR-008); o doc é a ÂNCORA VIVA que
      // `papelEventoAtivo()` confere via get() (docId = uid do membro ATIVO,
      // convenção da Function `setClaimsEquipe`). Por isso:
      //
      //   UPDATE de cliente: NEGADO POR INTEIRO — `papel`/`status`/`uid`
      //   mutáveis pelo cliente seriam vetor direto de AUTO-PROMOÇÃO (mudar
      //   o próprio papel no doc) ou de fraude da âncora (forjar
      //   status 'ativo' re-viveria um token velho já revogado). Troca de
      //   papel/remoção = SÓ a Function (claims + doc na MESMA operação).
      //
      //   CREATE de cliente = SÓ CONVITE (E04-L5): nasce status 'convidado',
      //   SEM `uid` (sem uid não vira âncora de ninguém) e NUNCA com papel
      //   'organizador' (nasce com o evento; transferência é superfície de
      //   Function). Quem convida: tenant writer OU equipe organizador/
      //   administrador (célula `equipe` da matriz 4×7 de @leela/core).
      //
      //   DELETE: só convite ('convidado'). Membro ATIVO sai SÓ pela Function
      //   — delete direto do doc deixaria claims órfãs no token (o acesso já
      //   morreria, âncora ausente = deny, mas a trilha 'removido' se perderia).
      //
      //   LEITURA: fora do catch-all (mesma disciplina de inscritos/cupons —
      //   e-mail de convite é PII leve; papel×pessoa é dado de gestão).
      match /equipe/{membroId} {

        /** Shape do CONVITE (única escrita de cliente aqui — ver bloco). */
        function shapeConviteValido() {
          return request.resource.data.eventoId == eventoId
            && request.resource.data.papel in ['administrador', 'operador', 'financeiro']
            && request.resource.data.status == 'convidado'
            && !request.resource.data.keys().hasAny(['uid'])
            && request.resource.data.nome is string
            && request.resource.data.nome.size() > 0;
        }

        allow read: if isPlatformAdmin()
                    || isTenantWriter(tenantDoEventoPai())
                    || papelEventoAtivo(['organizador', 'administrador']);
        allow create: if ((isTenantWriter(request.resource.data.tenantId)
                           || papelEventoAtivo(['organizador', 'administrador']))
                          && request.resource.data.tenantId == tenantDoEventoPai()
                          && tenantAtivo(request.resource.data.tenantId)
                          && shapeConviteValido())
                      || isPlatformAdmin();
        allow update: if isPlatformAdmin();
        allow delete: if ((isTenantWriter(resource.data.tenantId)
                           || papelEventoAtivo(['organizador', 'administrador']))
                          && tenantAtivo(resource.data.tenantId)
                          && resource.data.status == 'convidado')
                      || isPlatformAdmin();
      }

      // `politicaVendas/{config}` — política de reembolso/transferência/troca
      // (E04 · S305-T1 · RN-338/339/340/343/344). Doc ÚNICO por evento
      // (docId canônico `config` — truque do paginaVendas: 1-por-evento na
      // CHAVE). É CONFIG (parâmetros/janelas/flags) — a EXECUÇÃO (máquina de
      // reembolso, estorno, fila) é E09-S904 e escreve SÓ por Function.
      //
      // ESCRITA: SÓ o OWNER do tenant do evento (staff e papéis de evento
      // NEGADOS — política de reembolso é contrato legal do organizador;
      // aceite S305-T1 "não-owner ⇒ Rule nega"). Shape espelha
      // `validarPoliticaVendas` do kernel (ints com teto sanitário; taxa
      // 0..10000; booleans). NUNCA math.isInfinite/isNaN aqui (não existem no
      // runtime do emulator@13); NaN/Infinity falham as comparações de faixa
      // → deny (fail-closed por construção).
      // LEITURA: gestão (writer) + equipe organizador/administrador/
      // financeiro (config de dinheiro — matriz S304). Fora do catch-all.
      // DELETE: nunca por cliente (trilha de política; corrigir = sobrescrever).
      match /politicaVendas/{docId} {

        function shapePoliticaValida() {
          return request.resource.data.tenantId is string
            && request.resource.data.reembolso.janelaArrependimentoDias is int
            && request.resource.data.reembolso.janelaArrependimentoDias >= 0
            && request.resource.data.reembolso.janelaArrependimentoDias <= 90
            && request.resource.data.reembolso.corteHoras is int
            && request.resource.data.reembolso.corteHoras >= 0
            && request.resource.data.reembolso.corteHoras <= 720
            && request.resource.data.reembolso.slaAnaliseDias is int
            && request.resource.data.reembolso.slaAnaliseDias >= 0
            && request.resource.data.reembolso.slaAnaliseDias <= 30
            // RN-374 (decisão 42): campo NOVO — ausente é válido (política
            // legada ⇒ false na leitura, taxa retida fora da janela);
            // presente tem de ser bool. DENTRO da janela a taxa volta sempre
            // e não há campo para desligar isso (art. 49).
            && (!request.resource.data.reembolso.keys().hasAny(['devolveTaxaForaDaJanela'])
                || request.resource.data.reembolso.devolveTaxaForaDaJanela is bool)
            && request.resource.data.transferencia.habilitada is bool
            && request.resource.data.transferencia.janelaHoras is int
            && request.resource.data.transferencia.janelaHoras >= 1
            && request.resource.data.transferencia.janelaHoras <= 2160
            && request.resource.data.transferencia.taxa is number
            && request.resource.data.transferencia.taxa >= 0
            && request.resource.data.transferencia.taxa <= 10000
            && request.resource.data.trocaIngresso.habilitada is bool
            && request.resource.data.trocaIngresso.janelaHoras is int
            && request.resource.data.trocaIngresso.janelaHoras >= 1
            && request.resource.data.trocaIngresso.janelaHoras <= 2160
            && request.resource.data.trocaIngresso.permiteReembolsoDowngrade is bool;
        }

        /**
         * CKMOD (paralelo RN-149): campos de VERSÃO da política — escrita
         * EXCLUSIVA do trigger versionarPoliticaVendas (Admin SDK). Versão
         * forjada invalidaria a prova de aceite do pedido (`aceites.termos`
         * carimba a versão vigente). Cliente nem cria nem toca — espelho de
         * CAMPOS_FUNCTION_POLITICA_VENDAS do core.
         */
        function camposVersaoPoliticaNaoNascem() {
          return !request.resource.data.keys().hasAny(
            ['versao', 'versaoAtualizadaEm', 'politicaTextoHash']
          );
        }
        function camposVersaoPoliticaIntocados() {
          return !request.resource.data.diff(resource.data).affectedKeys().hasAny(
            ['versao', 'versaoAtualizadaEm', 'politicaTextoHash']
          );
        }

        allow read: if isPlatformAdmin()
                    || isTenantWriter(tenantDoEventoPai())
                    || papelEventoAtivo(['organizador', 'administrador', 'financeiro']);
        // F-2 (review CKMOD): o ramo platform_admin TAMBÉM respeita o
        // congelamento de versão — admin via client SDK setando `versao`/
        // `politicaTextoHash` suprimiria o bump futuro do trigger (hash
        // pré-plantado ⇒ mudança material silenciosa sob a mesma versão),
        // corrompendo toda prova de aceite. Admin de verdade usa Admin SDK.
        allow create: if (isTenantOwner(request.resource.data.tenantId)
                          && docId == 'config'
                          && request.resource.data.tenantId == tenantDoEventoPai()
                          && tenantAtivo(request.resource.data.tenantId)
                          && shapePoliticaValida()
                          && camposVersaoPoliticaNaoNascem())
                      || (isPlatformAdmin() && camposVersaoPoliticaNaoNascem());
        allow update: if (isTenantOwner(resource.data.tenantId)
                          && request.resource.data.tenantId == resource.data.tenantId
                          && tenantAtivo(resource.data.tenantId)
                          && shapePoliticaValida()
                          && camposVersaoPoliticaIntocados())
                      || (isPlatformAdmin() && camposVersaoPoliticaIntocados());
        allow delete: if false;
      }

      // `termoSaude/{config}` — termo de saúde CUSTOM do organizador (CK2 ·
      // RN-156 · DEC-0719 D-7). Doc ÚNICO por evento (docId `config`).
      // ADITIVO ao termo BASE da plataforma (que é sempre obrigatório e vive
      // como template do produto — nunca em doc). Texto '' = termo INATIVO
      // (desativação; DELETE nunca por cliente — trilha de versão).
      //
      // ESCRITA: SÓ o OWNER (contrato legal do organizador — mesmo aceite da
      // politicaVendas). Campos de VERSÃO (versao/versaoAtualizadaEm/
      // termoTextoHash) são EXCLUSIVOS do trigger versionarTermoSaude —
      // espelho de CAMPOS_FUNCTION_TERMO_SAUDE do core; forjá-los
      // invalidaria a prova de aceite `pedidos/{id}.aceites.saudeCustom`.
      // Mesma lição F-2 do CKMOD: platform_admin via client SDK TAMBÉM
      // respeita o congelamento.
      match /termoSaude/{docId} {

        function shapeTermoSaudeValido() {
          return request.resource.data.tenantId is string
            && request.resource.data.texto is string
            && request.resource.data.texto.size() <= 20000;
        }
        function camposVersaoTermoNaoNascem() {
          return !request.resource.data.keys().hasAny(
            ['versao', 'versaoAtualizadaEm', 'termoTextoHash']
          );
        }
        function camposVersaoTermoIntocados() {
          return !request.resource.data.diff(resource.data).affectedKeys().hasAny(
            ['versao', 'versaoAtualizadaEm', 'termoTextoHash']
          );
        }

        allow read: if isPlatformAdmin()
                    || isTenantWriter(tenantDoEventoPai())
                    || papelEventoAtivo(['organizador', 'administrador']);
        allow create: if (isTenantOwner(request.resource.data.tenantId)
                          && docId == 'config'
                          && request.resource.data.tenantId == tenantDoEventoPai()
                          && tenantAtivo(request.resource.data.tenantId)
                          && shapeTermoSaudeValido()
                          && camposVersaoTermoNaoNascem())
                      || (isPlatformAdmin() && camposVersaoTermoNaoNascem());
        allow update: if (isTenantOwner(resource.data.tenantId)
                          && request.resource.data.tenantId == resource.data.tenantId
                          && tenantAtivo(resource.data.tenantId)
                          && shapeTermoSaudeValido()
                          && camposVersaoTermoIntocados())
                      || (isPlatformAdmin() && camposVersaoTermoIntocados());
        allow delete: if false;
      }

      // `afiliados/{afiliadoId}` — afiliados/influenciadores do evento
      // (E08 antecipado · R9-E · S-R9-11 · RN-313..319). docId == refCodigo
      // (unicidade por chave, como cupons).
      //
      // ESCRITA: NEGADA para TODO client SDK — o ciclo inteiro é de
      // Function (`salvarAfiliado` / aceite PF / ∑ de conversão do webhook):
      // refCodigo é CHAVE, `conversoes`/`valorAtribuido` são ∑ RN-314,
      // `responsavelUid`/`tokenAceiteHash` são trust anchors RN-316/318 e a
      // amarração cupom↔afiliado exige transação dupla — nenhum pedaço é
      // seguro pelo cliente. (Postura pós-19c8afe: nem platform_admin via
      // client SDK; Admin SDK segue para tooling.)
      //
      // LEITURA (RN-318/319 — fail-closed): organizador (tenant writer) vê
      // os afiliados do PRÓPRIO evento; o PRÓPRIO influenciador
      // (responsavelUid — estampado por Function) vê SÓ o seu doc. O shape
      // não carrega dado de terceiros (documento SÓ mascarado; nenhum dado
      // de comprador). Membro genérico do tenant NÃO lê (e-mail do PF é
      // PII; refCodigo alheio é ativo de atribuição).
      match /afiliados/{afiliadoId} {
        allow read: if isPlatformAdmin()
                    || isTenantWriter(tenantDoEventoPai())
                    || (isSignedIn()
                        && resource.data.get('responsavelUid', '') == request.auth.uid);
        allow write: if false;

        // `conversoes/{conversaoId}` — 1 doc por PEDIDO confirmado
        // (RN-314): escrita EXCLUSIVA da Function do webhook (mesma tx da
        // confirmação — idempotente por chave). Shape SEM PII de comprador
        // (valor/instantes/pedidoRef). Leitura espelha o doc pai.
        // FASE 2 (COMF2): o doc carrega `comissao` + `comissaoConfig`
        // CONGELADOS — a negação total de escrita de cliente é o que impede
        // forjar/retocar comissão de conversão já registrada.
        match /conversoes/{conversaoId} {
          allow read: if isPlatformAdmin()
                      || isTenantWriter(tenantDoEventoPai())
                      || (isSignedIn()
                          && get(/databases/$(database)/documents/eventos/$(eventoId)/afiliados/$(afiliadoId))
                              .data.get('responsavelUid', '') == request.auth.uid);
          allow write: if false;
        }

        // `repasses/{repasseId}` — repasse MANUAL de comissão (E08 FASE 2 ·
        // COMF2 · item 23): registro de pagamento off-platform feito pelo
        // organizador; escrita EXCLUSIVA da Function
        // `registrarRepasseComissao` (guarda de saldo + ∑ na mesma tx —
        // cliente forjando repasse zeraria dívida real). Leitura espelha o
        // doc pai (organizador do tenant + o PRÓPRIO afiliado — RN-318).
        match /repasses/{repasseId} {
          allow read: if isPlatformAdmin()
                      || isTenantWriter(tenantDoEventoPai())
                      || (isSignedIn()
                          && get(/databases/$(database)/documents/eventos/$(eventoId)/afiliados/$(afiliadoId))
                              .data.get('responsavelUid', '') == request.auth.uid);
          allow write: if false;
        }
      }

      match /{subcol}/{docId} {
        // ALLOWLIST de leitura de membro (re-review Fable A-T2 A2): SÓ as
        // subcoleções explicitamente não-sensíveis (kits/lotes/paginaVendas)
        // são legíveis por membro genérico do tenant. A forma anterior era
        // BLOCKLIST (subcol != inscritos/cupons) — qualquer subcoleção FUTURA
        // de eventos (reembolsos/transferencias/ledger/…) nasceria
        // member-readable sem tocar as Rules. Agora nasce no deny-by-default:
        // abrir leitura exige entrar nesta lista (ou ganhar match próprio)
        // + teste. `inscritos` (PII/LGPD), `cupons` (ativo comercial),
        // `financeiro` (repasse), `comunicacoes`/`comunicacoesResumo`
        // (log de comunicação — PII, FABLE-G) e `equipe` (S304-T1 — papel ×
        // pessoa + e-mail de convite) têm match próprio restrito acima e NÃO
        // entram na lista — o OR de regras não os re-concede. As concessões
        // POR PAPEL DE EVENTO (S304-T1) vivem SÓ nos matches específicos,
        // nunca aqui: papel novo/área nova exige regra explícita + teste.
        allow read: if isPlatformAdmin()
                    || (subcol in ['kits', 'lotes', 'paginaVendas']
                        && isTenantMember(get(/databases/$(database)/documents/eventos/$(eventoId)).data.tenantId));
        // WRITE: NEGADO para TODO client SDK — platform_admin INCLUSO
        // (hardening O3-L1, achado sistêmico do LEELA-BEPEND). A forma
        // anterior (`if isPlatformAdmin()`) re-concedia, via OR de matches,
        // escrita de client nos agregados ∑ (`financeiro/current`,
        // `comunicacoesResumo`, `demografia`) cujos matches dedicados dizem
        // `write: if false` — no OR de Rules basta UM match permitir. Agora
        // os agregados são writer-only por Function DE FATO (Admin SDK
        // bypassa Rules — tooling de back-office usa Admin SDK, nunca client
        // SDK). Escrita de cliente em subcoleção de evento exige match
        // próprio + teste adversarial (deny-by-default, par do read acima).
        // Canário: demografia.integration prova a NEGAÇÃO (flipado neste lote).
        allow write: if false;
      }
    }

    // `clubes/{clubeId}` — módulo Clubs (E05 · S101-T1). docId = slug.
    //
    // Além do padrão tenant-scoped:
    //   - leitura PÚBLICA quando visibilidade in ['publica','indexavel']
    //     (RN-140 — página pública/SEO); clube 'privada' segue só tenant;
    //   - agregados ∑ (qtdMembrosAtivos, qtdDesafiosAtivos) são de escrita
    //     EXCLUSIVA da Cloud Function (Admin SDK): create exige 0/ausente,
    //     update não pode tocá-los (S101-T1/S103-T1);
    //   - delete NEGADO para TODO cliente (S110-T2 · RN-144): exclusão é
    //     EXCLUSIVA da Function `deleteClube` — cascata completa + retenção
    //     LGPD 90d em `clubesExcluidos` (sem match = deny-by-default, como
    //     `exportsClube`). Não existe caminho de exclusão que pule a retenção
    //     — nem platform_admin via client SDK (Admin SDK segue disponível
    //     para tooling).
    match /clubes/{clubeId} {

      /** Agregados ∑ nascem zerados (ou ausentes) — cliente nunca inventa contagem. */
      function clubeAgregadosZerados() {
        return request.resource.data.get('qtdMembrosAtivos', 0) == 0
          && request.resource.data.get('qtdDesafiosAtivos', 0) == 0;
      }

      /** Update de cliente não toca campos ∑ (só a Function os mantém). */
      function clubeAgregadosIntocados() {
        return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['qtdMembrosAtivos', 'qtdDesafiosAtivos']);
      }

      /** Identidade/propriedade NÃO mudam por write direto (review Onda1
          suplementar S1): `ownerId` só via Function `transferirPropriedade`
          (RN-106 — troca de dono sincroniza os papéis em `membros`);
          `codigoConvite` é gerado no create e estável (RN-101 — evita
          sequestro/colisão do código); `slug` espelha o docId (mudar slug é
          recriar o doc); `criadoEm` é trilha. */
      function clubeIdentidadeIntocada() {
        // ➕ E18 (fix review antagonista O3-L3B #2/#5): os campos de
        // assessoria parceira são TRUST ANCHOR de Function — cliente não
        // planta `ehAssessoriaParceira`/`parceiroDeTenant` em clube comum
        // nem adultera o `documentoMascarado` do parceiro.
        return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['ownerId', 'codigoConvite', 'slug', 'criadoEm',
                   'ehAssessoriaParceira', 'documentoMascarado',
                   'parceiroDeTenant']);
      }

      /** Espelho server-side do shape mínimo (review suplementar S6e/S6f):
          nome obrigatório 1..60 (validarClube, core) e modeloEntrada dentro
          do enum do domínio — 'pago' NÃO existe na V1 (RN-104; o chip da UI
          é disabled, mas UI não é fronteira de segurança). */
      function clubeShapeValido() {
        return request.resource.data.nome is string
          && request.resource.data.nome.trim().size() > 0
          && request.resource.data.nome.size() <= 60
          && request.resource.data.get('modeloEntrada', 'gratuito')
              in ['gratuito', 'pago_em_breve'];
      }

      /**
       * S1702-T1 (RN-166): capa do clube — quando presente, é null (sem capa)
       * ou URL http(s) curta. Nome CANÔNICO = `imagemUrl` (o MESMO do evento,
       * RN-153 — reconciliação O3-L2SEC; `capaUrl` fica só na capa de email
       * de campanha/comunicado, RN-135). A capa vira `src` de <img> em
       * superfície PÚBLICA: `javascript:`/`data:` nunca entram no doc
       * (espelho de isUrlCapaValida no core — defesa em profundidade).
       */
      function clubeCapaValida() {
        return !('imagemUrl' in request.resource.data)
          || request.resource.data.imagemUrl == null
          || (request.resource.data.imagemUrl is string
              && request.resource.data.imagemUrl.size() <= 2048
              && request.resource.data.imagemUrl.matches('https?://.*'));
      }

      allow read: if isTenantMember(resource.data.tenantId)
                  || isPlatformAdmin()
                  || resource.data.visibilidade in ['publica', 'indexavel'];
      allow create: if (isTenantWriter(request.resource.data.tenantId)
                        && tenantAtivo(request.resource.data.tenantId)
                        && clubeAgregadosZerados()
                        && clubeShapeValido()
                        && clubeCapaValida()
                        // E18 (fix #5): clube de assessoria parceira nasce
                        // SÓ pela Function — cliente não planta os campos.
                        && !request.resource.data.keys().hasAny(
                             ['ehAssessoriaParceira', 'documentoMascarado',
                              'parceiroDeTenant']))
                    || isPlatformAdmin();
      allow update: if (isTenantWriter(resource.data.tenantId)
                        && request.resource.data.tenantId == resource.data.tenantId
                        && tenantAtivo(resource.data.tenantId)
                        && clubeAgregadosIntocados()
                        && clubeIdentidadeIntocada()
                        && clubeShapeValido()
                        && clubeCapaValida())
                    || isPlatformAdmin();
      allow delete: if false;

      /** tenantId do clube pai — subcoleções carregam tenantId coerente (ADR-009). */
      function tenantDoClubePai() {
        return get(/databases/$(database)/documents/clubes/$(clubeId)).data.tenantId;
      }

      // `membros/{membroId}` — join Atleta↔Clube (E05 · S103-T1).
      //
      // RN-102: `status` é DERIVADO por data — escrita EXCLUSIVA da Cloud
      // Function (onMembroWrite + cron recalcularStatusMembros). O mesmo vale
      // para `ultimaAtividadeEm` (trilha de atividade). Papel de escrita do
      // tenant gerencia membros (remover/transferir — S103-T2), mas nunca
      // inventa status nem atividade. Membros NUNCA são públicos, mesmo em
      // clube com visibilidade 'publica' — leitura só do tenant dono.
      match /membros/{membroId} {

        /** Papel dentro do enum canônico (RN-103). */
        function papelMembroValido() {
          return request.resource.data.papel in ['owner', 'admin', 'membro'];
        }

        /** Via de entrada dentro do enum canônico. */
        function entradaViaValida() {
          return request.resource.data.entrouVia in ['codigo', 'convite', 'link'];
        }

        /** Cliente não CRIA doc já carimbado com campos de Function (RN-102). */
        function semCamposDeFunctionMembro() {
          return !request.resource.data.keys().hasAny(['status', 'ultimaAtividadeEm']);
        }

        /** Update de cliente não TOCA campos de Function (RN-102). */
        function camposDeFunctionMembroIntocados() {
          return !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['status', 'ultimaAtividadeEm']);
        }

        allow read: if isPlatformAdmin()
                    || isTenantMember(tenantDoClubePai());
        allow create: if (isTenantWriter(request.resource.data.tenantId)
                          && request.resource.data.tenantId == tenantDoClubePai()
                          && tenantAtivo(request.resource.data.tenantId)
                          && papelMembroValido()
                          && entradaViaValida()
                          && semCamposDeFunctionMembro())
                      || isPlatformAdmin();
        allow update: if (isTenantWriter(resource.data.tenantId)
                          && request.resource.data.tenantId == resource.data.tenantId
                          && tenantAtivo(resource.data.tenantId)
                          && papelMembroValido()
                          && entradaViaValida()
                          && camposDeFunctionMembroIntocados())
                      || isPlatformAdmin();
        allow delete: if (isTenantWriter(resource.data.tenantId)
                          && tenantAtivo(resource.data.tenantId))
                      || isPlatformAdmin();
      }

      // `desafios/{desafioId}` — motor de engajamento (E05 · S105-T1).
      //
      // RN-110/116/117: modelo/recompensa/visibilidade dentro dos enums.
      // Agregados ∑ de progresso (qtdParticipantes, progressoPct,
      // progressoPorPilar) são de escrita EXCLUSIVA da Cloud Function
      // (registros de ação chegam no E13): create exige zerados/ausentes,
      // update não pode tocá-los. `clubes.qtdDesafiosAtivos` é recontado
      // pela Function onDesafioWrite. Validações condicionais por modelo
      // (meta por ação no A; minimoPorPilar no C — RN-111) vivem em
      // packages/core (validarPublicacao, S106-T1) — a Rule trava enums e
      // campos de Function; o "publicar" honesto é responsabilidade do
      // cliente autenticado do próprio tenant.
      match /desafios/{desafioId} {

        /** Shape básico do desafio — enums canônicos (RN-110/116/117) +
            datas coerentes (review suplementar S6d: timestamps e
            fim > início, espelho de validarDesafio no core). */
        function shapeDesafioValido() {
          return request.resource.data.modelo in ['A', 'B', 'C']
            && request.resource.data.status in ['rascunho', 'ativo', 'encerrado']
            && request.resource.data.recompensaTipo in
                ['medalha_digital', 'cupom', 'medalha_fisica', 'custom']
            && request.resource.data.visibilidade in ['membros', 'convite', 'publico']
            && request.resource.data.nome is string
            && request.resource.data.nome.size() > 0
            && request.resource.data.dataInicio is timestamp
            && request.resource.data.dataFim is timestamp
            && request.resource.data.dataFim > request.resource.data.dataInicio;
        }

        /** RN-111 (mínimo por pilar no C; meta por ação no A) segue
            CLIENT-SIDE (validarPublicacao, core) — punt VIGENTE documentado
            no review suplementar S6b, decisão de produto PENDENTE sobre
            espelhar no servidor. Estado atual congelado por teste
            (desafiosRules: "estado vigente RN-111"). Não endurecer aqui
            sem decisão do produto. */

        /** Matriz de transição de status (S7/T14 — decisão do Vitor):
            'encerrado' PODE voltar a 'ativo', mas SOMENTE pelo dono do
            clube (ownerId do clube pai); staff/membros não reabrem, e
            'encerrado' não vira 'rascunho'. Demais transições livres
            para writers. */
        function transicaoStatusDesafioValida() {
          return resource.data.status != 'encerrado'
            || request.resource.data.status == 'encerrado'
            || (request.resource.data.status == 'ativo'
                && request.auth.uid ==
                    get(/databases/$(database)/documents/clubes/$(clubeId))
                      .data.ownerId);
        }

        /** Agregados ∑ nascem zerados/ausentes — cliente nunca inventa progresso. */
        function desafioAgregadosZerados() {
          return request.resource.data.get('qtdParticipantes', 0) == 0
            && request.resource.data.get('progressoPct', 0) == 0
            && !('progressoPorPilar' in request.resource.data);
        }

        /** Update de cliente não toca campos ∑ (só a Function os mantém). */
        function desafioAgregadosIntocados() {
          return !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['qtdParticipantes', 'progressoPct', 'progressoPorPilar']);
        }

        allow read: if isPlatformAdmin()
                    || isTenantMember(tenantDoClubePai());
        allow create: if (isTenantWriter(request.resource.data.tenantId)
                          && request.resource.data.tenantId == tenantDoClubePai()
                          && tenantAtivo(request.resource.data.tenantId)
                          && shapeDesafioValido()
                          && desafioAgregadosZerados())
                      || isPlatformAdmin();
        allow update: if (isTenantWriter(resource.data.tenantId)
                          && request.resource.data.tenantId == resource.data.tenantId
                          && tenantAtivo(resource.data.tenantId)
                          && shapeDesafioValido()
                          && transicaoStatusDesafioValida()
                          && desafioAgregadosIntocados())
                      || isPlatformAdmin();
        allow delete: if (isTenantWriter(resource.data.tenantId)
                          && tenantAtivo(resource.data.tenantId))
                      || isPlatformAdmin();

        // Junção N:N Desafio↔CatálogoAção — `acoes/{acaoId}` (docId = id da
        // ação no catálogo global). `meta` opcional (obrigatória só no
        // Modelo A — validação de publicação em core, S106-T1).
        match /acoes/{acaoId} {

          /** Shape da junção: acaoRef coerente com o docId; meta number > 0. */
          function shapeAcaoDesafioValido() {
            return request.resource.data.acaoRef is string
              && request.resource.data.acaoRef == acaoId
              && (!('meta' in request.resource.data)
                  || (request.resource.data.meta is number
                      && request.resource.data.meta > 0));
          }

          allow read: if isPlatformAdmin()
                      || isTenantMember(tenantDoClubePai());
          allow create, update: if (isTenantWriter(tenantDoClubePai())
                                    && tenantAtivo(tenantDoClubePai())
                                    && shapeAcaoDesafioValido())
                                || isPlatformAdmin();
          allow delete: if (isTenantWriter(tenantDoClubePai())
                            && tenantAtivo(tenantDoClubePai()))
                        || isPlatformAdmin();
        }

        // `participantes/{participanteId}` — participação do atleta no
        // desafio (S1307-T1/S1308-T1 · E13 adiantado · Onda 2 T2-L2).
        // ESCRITA: NUNCA pelo cliente — pontos/pontosPorPilar/diasAtivos
        // são ∑ de Function (onRegistroWrite, recompute idempotente) e a
        // criação passa pelo callable entrarNoDesafio (valida RN-117 no
        // servidor). Cliente escrevendo participação = pontuação forjada.
        // LEITURA conforme visibilidade (RN-117):
        //   - tenant do clube (owner/staff/promoter) + platform_admin;
        //   - o PRÓPRIO atleta participante (uid == docId);
        //   - desafio 'publico': qualquer autenticado;
        //   - 'membros'/'convite': atleta que JÁ participa lê os demais
        //     (board social) — não-participante não enxerga nada (o check
        //     de membro por uid é impossível em Rules: membros/{docId} não
        //     é keyed por uid; a fronteira REAL do join é entrarNoDesafio).
        match /participantes/{participanteId} {

          /** Visibilidade do desafio pai (get — 1 leitura). */
          function visibilidadeDesafioPai() {
            return get(/databases/$(database)/documents/clubes/$(clubeId)/desafios/$(desafioId))
              .data.visibilidade;
          }

          /** Caller já participa deste desafio? */
          function callerParticipa() {
            return exists(/databases/$(database)/documents/clubes/$(clubeId)/desafios/$(desafioId)/participantes/$(request.auth.uid));
          }

          allow read: if isPlatformAdmin()
                      || isTenantMember(tenantDoClubePai())
                      || (isSignedIn()
                          && (request.auth.uid == participanteId
                              || visibilidadeDesafioPai() == 'publico'
                              || callerParticipa()));
          allow write: if false;
        }

        // `board/{docId}` — BOARD DE CONSISTÊNCIA materializado
        // (S1308-T3 · decisão 2: anti-streak ético — ordena por dias
        // ativos, NUNCA por volume bruto). Top-N em `board/current`,
        // recomputado pela Function no fan-out de onRegistroWrite.
        // ESCRITA: NUNCA pelo cliente (board forjado = fraude de
        // reconhecimento social). LEITURA: espelha participantes —
        // tenant do clube, participante do desafio, ou desafio 'publico'.
        match /board/{docId} {

          /** Visibilidade do desafio pai (helpers têm escopo por match). */
          function visibilidadeDesafioPaiBoard() {
            return get(/databases/$(database)/documents/clubes/$(clubeId)/desafios/$(desafioId))
              .data.visibilidade;
          }

          /** Caller participa deste desafio? */
          function callerParticipaBoard() {
            return exists(/databases/$(database)/documents/clubes/$(clubeId)/desafios/$(desafioId)/participantes/$(request.auth.uid));
          }

          allow read: if isPlatformAdmin()
                      || isTenantMember(tenantDoClubePai())
                      || (isSignedIn()
                          && (visibilidadeDesafioPaiBoard() == 'publico'
                              || callerParticipaBoard()));
          allow write: if false;
        }
      }

      // `parcerias/{parceriaId}` — captura de valor do clube (E05 · S107-T1).
      //
      // Union por `tipo` (RN-123): evento_afiliado | patrocinador.
      // RN-120/122: comissão/termos/link/cupom são espelhados por Function a
      // partir do programa do ORGANIZADOR — read-only para o clube. Em
      // evento_afiliado o clube apenas TRANSICIONA `status` (aceitar/recusar/
      // pausar). Agregados ∑ (conversoes, valorAReceber) só via Function
      // (recontagem — onConversao). Patrocinador é CRUD do próprio clube,
      // com shape (RN-123 + SPEC-02).
      match /parcerias/{parceriaId} {

        /** Campos espelhados do programa (RN-120/122) + ∑ — intocáveis.
            `eventoNome` (CONS-4-T2): nome canônico denormalizado de
            eventos/{eventoId}.nome por Function — cliente nunca escreve. */
        function camposProtegidosParceria() {
          return ['comissaoPct', 'cupom', 'linkMaster', 'janelaAtribuicaoDias',
                  'termosEspelho', 'programaAfiliacaoRef', 'eventoNome',
                  'conversoes', 'valorAReceber'];
        }

        /** Ciclo de vida dentro do enum canônico. */
        function statusParceriaValido() {
          return request.resource.data.status in
            ['convite_pendente', 'ativa', 'inativa'];
        }

        /** Shape do patrocinador (RN-123): modelo no enum; contrapartida
            ≥ 20 chars (SPEC-02); financeiro exige valorAnual > 0; nunca
            nasce com campos de afiliação/∑ (fraude de shape). */
        function shapePatrocinadorValido() {
          return request.resource.data.tipo == 'patrocinador'
            && statusParceriaValido()
            && request.resource.data.modeloComercial in ['financeiro', 'permuta']
            && request.resource.data.contrapartida is string
            && request.resource.data.contrapartida.size() >= 20
            && (request.resource.data.modeloComercial != 'financeiro'
                || (request.resource.data.get('valorAnual', 0) is number
                    && request.resource.data.get('valorAnual', 0) > 0))
            // Logo 1:1 do patrocinador (R9-E · adendo S-R9-12): quando
            // presente, URL http(s) curta — vira <img> em página pública
            // (javascript:/data: nunca entram; espelho de capaValida).
            && (!('logoUrl' in request.resource.data)
                || (request.resource.data.logoUrl is string
                    && request.resource.data.logoUrl.size() <= 2048
                    && request.resource.data.logoUrl.matches('https?://.*')))
            && !request.resource.data.keys().hasAny(camposProtegidosParceria());
        }

        allow read: if isPlatformAdmin()
                    || isTenantMember(tenantDoClubePai());

        // Create de cliente: APENAS patrocinador — convite de evento_afiliado
        // nasce do organizador via Function (Admin SDK bypassa Rules).
        allow create: if (isTenantWriter(request.resource.data.tenantId)
                          && request.resource.data.tenantId == tenantDoClubePai()
                          && tenantAtivo(request.resource.data.tenantId)
                          && shapePatrocinadorValido())
                      || isPlatformAdmin();

        // Update: evento_afiliado → SÓ transição de status (RN-120/122);
        //         patrocinador → edição com shape (não vira afiliado).
        allow update: if (isTenantWriter(resource.data.tenantId)
                          && request.resource.data.tenantId == resource.data.tenantId
                          && tenantAtivo(resource.data.tenantId)
                          && statusParceriaValido()
                          && ((resource.data.tipo == 'evento_afiliado'
                               && request.resource.data.diff(resource.data)
                                    .affectedKeys()
                                    .hasOnly(['status', 'atualizadoEm']))
                              || (resource.data.tipo == 'patrocinador'
                                  && shapePatrocinadorValido())))
                      || isPlatformAdmin();

        // Delete: patrocinador pode; evento_afiliado NUNCA pelo cliente
        // (trilha financeira de conversões não some).
        allow delete: if (isTenantWriter(resource.data.tenantId)
                          && tenantAtivo(resource.data.tenantId)
                          && resource.data.tipo == 'patrocinador')
                      || isPlatformAdmin();

        // `conversoes/{conversaoId}` — trilha ∑ de atribuição (RN-125).
        // Escrita EXCLUSIVA da Function (onConversao, Admin SDK). Leitura
        // tenant-only; cliente nunca cria/edita/deleta conversão.
        match /conversoes/{conversaoId} {
          allow read: if isPlatformAdmin()
                      || isTenantMember(tenantDoClubePai());
          allow write: if false;
        }
      }

      // `comunicados/{comunicadoId}` — comunicação segmentada (E05 · S108-T1).
      //
      // RN-130: cliente cria/edita APENAS rascunho/agendado — o carimbo
      // 'enviado' (+ enviadoEm/alcance/aberturasPct) é EXCLUSIVO da Function
      // de envio (onComunicadoEnvio, que também valida o limite RN-133).
      // Comunicado enviado é imutável e indeletável para o cliente (trilha).
      // RN-131/132: canal 1..2 dentro do enum; origem no enum.
      // RN-135: imagem de capa só existe quando o canal inclui email.
      match /comunicados/{comunicadoId} {

        /** Shape básico (RN-131/132 + segmento + RN-135) + espelho mínimo
            de título/conteúdo (review suplementar S6c — SPEC-02/RN-134:
            título ≥ 5, conteúdo ≥ 10 após trim, como validarComunicado). */
        function shapeComunicadoValido() {
          return request.resource.data.canal is list
            && request.resource.data.canal.size() >= 1
            && request.resource.data.canal.size() <= 2
            && request.resource.data.canal.hasOnly(['push', 'email'])
            && request.resource.data.origem in ['manual', 'automatizada']
            && request.resource.data.segmento.tipo in
                ['todos', 'por_desafio', 'por_pilar', 'por_engajamento',
                 'novos_membros']
            && (!('capaUrl' in request.resource.data)
                || 'email' in request.resource.data.canal)
            && request.resource.data.titulo is string
            && request.resource.data.titulo.trim().size() >= 5
            && request.resource.data.conteudo is string
            && request.resource.data.conteudo.trim().size() >= 10;
        }

        /** 'agendado' exige `agendadoPara` timestamp (review suplementar
            S6a — o form valida, a rule espelha; a Function de envio/cron
            E04/E12 consumirá agendados confiando neste invariante). */
        function agendamentoCoerente() {
          return request.resource.data.status != 'agendado'
            || (('agendadoPara' in request.resource.data)
                && request.resource.data.agendadoPara is timestamp);
        }

        /** Cliente nunca escreve status 'enviado' (RN-130). */
        function statusEditavelPeloCliente() {
          return request.resource.data.status in ['rascunho', 'agendado'];
        }

        /** Cliente não CRIA doc carimbado com campos da Function de envio. */
        function semCamposDeEnvio() {
          return !request.resource.data.keys().hasAny(['enviadoEm', 'aberturasPct'])
            && request.resource.data.get('alcance', 0) == 0;
        }

        /** Update de cliente não TOCA campos da Function de envio. */
        function camposDeEnvioIntocados() {
          return !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['alcance', 'aberturasPct', 'enviadoEm']);
        }

        allow read: if isPlatformAdmin()
                    || isTenantMember(tenantDoClubePai());
        allow create: if (isTenantWriter(request.resource.data.tenantId)
                          && request.resource.data.tenantId == tenantDoClubePai()
                          && tenantAtivo(request.resource.data.tenantId)
                          && shapeComunicadoValido()
                          && agendamentoCoerente()
                          && statusEditavelPeloCliente()
                          && semCamposDeEnvio())
                      || isPlatformAdmin();
        allow update: if (isTenantWriter(resource.data.tenantId)
                          && request.resource.data.tenantId == resource.data.tenantId
                          && tenantAtivo(resource.data.tenantId)
                          && resource.data.status != 'enviado'
                          && shapeComunicadoValido()
                          && agendamentoCoerente()
                          && statusEditavelPeloCliente()
                          && camposDeEnvioIntocados())
                      || isPlatformAdmin();
        allow delete: if (isTenantWriter(resource.data.tenantId)
                          && tenantAtivo(resource.data.tenantId)
                          && resource.data.status != 'enviado')
                      || isPlatformAdmin();
      }

      // Catch-all de subcoleções de CLUBES — deny-by-default TOTAL para client
      // SDK (LEELA-R2, achado sistêmico dos EVENTOS em 19c8afe + lição A-T2 +
      // fix F1-01 das revisões antagonistas: mais estrito que o de eventos).
      //
      // READ = if false (nem platform_admin pelo client). A forma anterior
      // (`isTenantMember(tenantDoClubePai())` para QUALQUER subcol) expunha a
      // membro genérico as subcoleções SEM match próprio — hoje `convites`
      // (hash do token de aceite E18 + e-mail = PII; ler o doc minava o
      // fail-closed do pre-hijack 9e7e017 e dava estado/expiração ao atacante)
      // e `permissoesAdmin` (interna da cascata LGPD do deleteClube). Manter
      // `isPlatformAdmin()` no read (paridade com eventos) deixaria e-mail +
      // tokenAceiteHash de TODO convite legíveis por um claim admin via
      // browser, cross-tenant (F1-01). Fechado: NENHUMA subcol de clube tem
      // leitura de cliente legítima sem match próprio — tudo que o cliente lê
      // (membros/desafios+acoes/participantes/board/parcerias+conversoes/
      // comunicados) tem match dedicado acima; back-office usa Admin SDK
      // (bypassa Rules). Abrir leitura nova exige match próprio + teste.
      //
      // WRITE = if false para TODO client SDK — platform_admin incluso
      // (padrão pós-19c8afe: o OR de matches não re-concede onde os matches
      // dedicados dizem write:false). NUNCA reabrir.
      match /{subcol}/{docId} {
        allow read, write: if false;
      }
    }

    // Coleção legada `/inscritos` (top-level) — APOSENTADA (review Onda1 #4).
    // Inscrito vive APENAS na subcoleção canônica `eventos/{id}/inscritos`
    // (E03 · S203-T1), que valida shape + guarda campos de Function. A rule
    // legada (mais fraca — sem shape, sem guarda de kit/status/chip/qrToken)
    // foi removida: o caminho top-level cai no deny-by-default do final do
    // arquivo. NÃO reintroduzir sem rule endurecida + teste adversarial.

    // Coleções legadas `/comunicados` e `/parcerias` (top-level) — APOSENTADAS
    // (review Onda1 #10 / suplementar S3, mesmo padrão do fechamento de
    // /inscritos no review #4). As coleções canônicas são SUBCOLEÇÕES de
    // `clubes/{id}` — é lá que vivem os guardas (RN-130 anti-'enviado',
    // espelhados read-only RN-120/122, shape de patrocinador RN-123). As
    // rules legadas (sem shape, sem guarda) permitiam fabricar
    // `status:'enviado'/alcance` ou `comissaoPct/conversoes` forjados.
    // Removidas: os caminhos top-level caem no deny-by-default do final do
    // arquivo. NÃO reintroduzir sem rule endurecida + teste adversarial.

    // ── `perfis/{handle}` — perfil público / link-in-bio (E17 · S1700) ────
    //
    // Registry: docId = handle NORMALIZADO minúsculo (RN-160 — unicidade
    // global case-insensitive é estrutural: dois casings colidem no MESMO
    // docId). ESCRITA: EXCLUSIVA da Function `salvarPerfil` (Admin SDK) —
    // unicidade, imutabilidade do handle e lista de reservados são
    // invariantes de registro que Rules não serializam; cliente NUNCA
    // escreve (nem platform_admin via client SDK — padrão pós-19c8afe).
    // LEITURA: a superfície PÚBLICA do perfil é EXCLUSIVAMENTE o leitor da
    // landing (Admin SDK + projeção allowlist `projetarPerfilPublico`) — o
    // client SDK NÃO lê perfil de terceiros, nem `publica` (review
    // antagonista O3-L2SEC #1: liberar o doc inteiro exporia `ownerUid` =
    // Auth UID + `tenantId` a qualquer anônimo; fail-closed até existir
    // consumidor client-side com projeção própria). O tenant dono lê o
    // PRÓPRIO perfil (editor do painel); platform_admin lê tudo.
    //
    // Subcoleção `posts` (Feed, RN-163) é Onda 4 — SEM match aqui: cai no
    // deny-by-default (catch-all: subcoleção nova com dado de pessoa exige
    // regra própria + teste antes de existir).
    match /perfis/{handle} {
      allow read: if isTenantMember(resource.data.tenantId)
                  || isPlatformAdmin();
      allow write: if false;
    }

    match /programaAfiliacao/{docId} {
      allow read: if isTenantMember(resource.data.tenantId) || isPlatformAdmin();
      allow create: if (isTenantWriter(request.resource.data.tenantId)
                        && tenantAtivo(request.resource.data.tenantId))
                    || isPlatformAdmin();
      allow update: if (isTenantWriter(resource.data.tenantId)
                        && request.resource.data.tenantId == resource.data.tenantId
                        && tenantAtivo(resource.data.tenantId))
                    || isPlatformAdmin();
      allow delete: if (isTenantWriter(resource.data.tenantId)
                        && tenantAtivo(resource.data.tenantId))
                    || isPlatformAdmin();
    }

    match /pagamentos/{docId} {
      // LEITURA restrita a papel de GESTÃO (owner/staff via isTenantWriter),
      // igual a `pedidos` (fix coerência financeira — revisão r1): o pagamento
      // expõe cartão mascarado, valorFinal e repasse. promoter é membro do
      // tenant (lê outras coleções) mas NÃO enxerga dinheiro pelo cliente nesta
      // fase — dinheiro segue a mesma taxonomia de `pedidos`.
      allow read: if isTenantWriter(resource.data.tenantId) || isPlatformAdmin();
      // Escrita de estado financeiro apenas por Function
      allow write: if false;

      // `estornos/{inscritoId}` — ledger do estorno POR INSCRITO (RN-337/341
      // · ADR-011 · FABLE-B). Trilha de auditoria de dinheiro (quem/quando/
      // quanto/motivo + refundId do gateway + valor CONGELADO): escrita
      // EXCLUSIVA da Function `estornarInscricao` (Admin SDK) — cliente
      // forjar/alterar um doc aqui fabricaria/apagaria devolução de dinheiro.
      // Leitura segue a taxonomia financeira do pai (owner/staff do tenant,
      // via tenantId denormalizado no próprio doc do ledger).
      match /estornos/{inscritoId} {
        allow read: if isTenantWriter(resource.data.tenantId) || isPlatformAdmin();
        allow write: if false;
      }
    }

    // `pedidos/{pedidoId}` — pedido em grupo (ADR-011 · FABLE-A-T1).
    //
    // Coleção ROOT tenant-scoped por campo (`tenantId` + `eventoId`
    // denormalizados — mesma fronteira de `pagamentos`).
    //
    // LEITURA: nesta fase SÓ o organizador — papel de gestão do tenant dono
    // (tenant_owner/tenant_staff via isTenantWriter) ou platform_admin.
    // Guarda de PAPEL de propósito (review r1 fix 3): claim.tenantId puro
    // deixaria um token `role:'athlete'` com tenantId forjado ler, e
    // promoter (que lê outras coleções do tenant) enxergaria estado
    // FINANCEIRO — aqui vale a taxonomia do arquivo: owner/staff gerem,
    // promoter não vê dinheiro pelo cliente nesta fase.
    // TODO(E12/checkout): o responsável/atleta lê o PRÓPRIO pedido só na
    // story do checkout, com teste (mesmo gate do TODO de leitura pública
    // de eventos). NÃO abrir antes.
    //
    // ESCRITA: NUNCA pelo cliente — estado financeiro (status, valorTotal,
    // pagamentoRef, formaPagamento, parcelas — CAMPOS_FUNCTION_PEDIDO no
    // core) é de escrita EXCLUSIVA de Function (Admin SDK bypassa Rules).
    // Negado até para platform_admin via client SDK (mesmo padrão de
    // `pagamentos` e do dashboard) — pedido forjado é fraude financeira.
    // CKMOD: `endereco` (PII do comprador) e `aceites` (prova versionada
    // RN-149 pattern) moram AQUI e herdam o write:false — inforjáveis e
    // irretocáveis por cliente por construção (escrita só na Function do
    // checkout, na MESMA tx que cria o pedido).
    match /pedidos/{pedidoId} {
      allow read: if isTenantWriter(resource.data.tenantId) || isPlatformAdmin();
      allow write: if false;
    }

    // `pessoas/{pessoaId}` — registro GLOBAL de identidade por CPF (CK2 ·
    // RN-173). docId = HMAC do CPF (path sem PII); o DOC carrega CPF em
    // claro + dados conhecidos + contaUid/contaEmail — PII pura, cross-tenant.
    // TUDO fechado para cliente (leitura incluída — nem platform_admin via
    // client SDK): a escrita de DADOS é da Function do checkout (na tx do
    // pedido); o CLAIM (contaUid+contaEmail) tem escritor ÚNICO — a
    // confirmação de pagamento (RN-174/RN-155); a ÚNICA leitura de
    // superfície é o callable getCheckoutPrefill, que devolve SÓ o registro
    // da PRÓPRIA conta autenticada com pagamento confirmado + e-mail da
    // compra verificado e correspondente (RN-172/RN-174 — PII de terceiro
    // nunca atravessa).
    match /pessoas/{pessoaId} {
      allow read, write: if false;
    }

    // `equipe` — gestão de time do tenant: write restrito ao tenant_owner
    // (staff/promoter não gerenciam a própria equipe pelo cliente).
    match /equipe/{docId} {
      allow read: if isTenantMember(resource.data.tenantId) || isPlatformAdmin();
      allow create: if (isTenantOwner(request.resource.data.tenantId)
                        && tenantAtivo(request.resource.data.tenantId))
                    || isPlatformAdmin();
      allow update: if (isTenantOwner(resource.data.tenantId)
                        && request.resource.data.tenantId == resource.data.tenantId
                        && tenantAtivo(resource.data.tenantId))
                    || isPlatformAdmin();
      allow delete: if (isTenantOwner(resource.data.tenantId)
                        && tenantAtivo(resource.data.tenantId))
                    || isPlatformAdmin();
    }

    match /promotores/{docId} {
      allow read: if isTenantMember(resource.data.tenantId) || isPlatformAdmin();
      allow create: if (isTenantWriter(request.resource.data.tenantId)
                        && tenantAtivo(request.resource.data.tenantId))
                    || isPlatformAdmin();
      allow update: if (isTenantWriter(resource.data.tenantId)
                        && request.resource.data.tenantId == resource.data.tenantId
                        && tenantAtivo(resource.data.tenantId))
                    || isPlatformAdmin();
      allow delete: if (isTenantWriter(resource.data.tenantId)
                        && tenantAtivo(resource.data.tenantId))
                    || isPlatformAdmin();
    }

    // `itensKit/{itemId}` — catálogo de itens de kit do organizador
    // (E03 · S205-T1). Tenant-scoped; item referencia kits do evento via
    // `kits[]` (N:N Kit↔Item — RN-215) e carrega `eventoId`.
    //
    // Shape: RN-212 (tamanhado bool), RN-213 (origem organizador|patrocinador),
    // RN-214 (exibirLogo só faz sentido em item patrocinado — organizador
    // sempre false). `usadoEm` é índice inverso DESNORMALIZADO mantido pela
    // Function itemKitIndex — cliente nunca escreve.
    match /itensKit/{itemId} {

      /**
       * Shape do item (RN-212/213/214) — enums e booleans coerentes.
       * `modeloEstoque`/`tamanhosDisponiveis` (RN-225/223 · S210-T1) são
       * config do ORGANIZADOR (cliente escreve) — validados quando presentes;
       * ausentes = doc legado (o parse do core normaliza sob_encomenda/[]).
       * `grade` (RN-231 · TAMANHOS-GRADE): grade por corte do item tamanhado —
       * lista não-vazia, só em item tamanhado (validação profunda de cada
       * linha {corte, tamanhos[]} é do core/Functions — validarGradeItem —
       * mesma profundidade adotada para tamanhosDisponiveis).
       */
      function shapeItemKitValido() {
        return request.resource.data.nome is string
          && request.resource.data.nome.size() > 0
          && request.resource.data.tamanhado is bool
          && request.resource.data.origem in ['organizador', 'patrocinador']
          && request.resource.data.exibirLogo is bool
          && (request.resource.data.origem == 'patrocinador'
              || request.resource.data.exibirLogo == false)
          && request.resource.data.kits is list
          && request.resource.data.eventoId is string
          && request.resource.data.eventoId.size() > 0
          && (!request.resource.data.keys().hasAny(['modeloEstoque'])
              || request.resource.data.modeloEstoque in ['sob_encomenda', 'estoque_proprio'])
          && (!request.resource.data.keys().hasAny(['tamanhosDisponiveis'])
              || request.resource.data.tamanhosDisponiveis is list)
          && (!request.resource.data.keys().hasAny(['grade'])
              || (request.resource.data.grade is list
                  && request.resource.data.grade.size() > 0
                  && request.resource.data.tamanhado == true));
      }

      /**
       * Coerência de tenant com o EVENTO referenciado (ADR-009): o item só
       * aponta evento do PRÓPRIO tenant — sem itens órfãos em evento alheio.
       */
      function eventoDoItemCoerente() {
        return get(/databases/$(database)/documents/eventos/$(request.resource.data.eventoId))
          .data.tenantId == request.resource.data.tenantId;
      }

      /** Cliente não CRIA item com índice inverso carimbado (só Function). */
      function semUsadoEm() {
        return !request.resource.data.keys().hasAny(['usadoEm']);
      }

      /** Update de cliente não TOCA o índice inverso (só Function). */
      function usadoEmIntocado() {
        return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['usadoEm']);
      }

      allow read: if isTenantMember(resource.data.tenantId) || isPlatformAdmin();
      allow create: if (isTenantWriter(request.resource.data.tenantId)
                        && tenantAtivo(request.resource.data.tenantId)
                        && shapeItemKitValido()
                        && eventoDoItemCoerente()
                        && semUsadoEm())
                    || isPlatformAdmin();
      allow update: if (isTenantWriter(resource.data.tenantId)
                        && request.resource.data.tenantId == resource.data.tenantId
                        && tenantAtivo(resource.data.tenantId)
                        && shapeItemKitValido()
                        && eventoDoItemCoerente()
                        && usadoEmIntocado())
                    || isPlatformAdmin();
      allow delete: if (isTenantWriter(resource.data.tenantId)
                        && tenantAtivo(resource.data.tenantId))
                    || isPlatformAdmin();
    }

    // ── Coleções globais ──────────────────────────────────────────────────

    /**
     * `atletas/{atletaId}` — identidade global cross-tenant (ADR-009).
     * Leitura: o próprio atleta (uid bate com o doc) ou platform_admin.
     * Escrita: o próprio atleta ou Function (onCreateUser usa Admin SDK).
     *
     * Nota: Functions gravam via Admin SDK e não passam por estas Rules.
     */
    match /atletas/{atletaId} {
      allow read: if (isSignedIn() && request.auth.uid == atletaId)
                  || isPlatformAdmin();
      allow write: if isSignedIn() && request.auth.uid == atletaId;

      // `registros/{registroId}` — log de ação da jornada (S1307-T1 · E13
      // adiantado · Onda 2 T2-L2). ESCRITA SÓ DO DONO, com shape espelhado
      // de validarRegistro (core): quantidade finita > 0 (sem
      // math.isInfinite — runtime do Emulator não implementa; `v*0.0==0.0`
      // reprova NaN/±Infinity), pilar/origem nos enums, par clubeId+
      // desafioId ambos-ou-nenhum (path aninhado ADR-009). O campo `pontos`
      // NUNCA entra pelo cliente — pontuação (bônus RN-115) é ∑ da Function
      // onRegistroWrite em participantes/{uid}.
      // LEITURA: só o próprio atleta + platform_admin (jornada é pessoal).
      match /registros/{registroId} {

        /** Shape do registro — espelho server-side de validarRegistro. */
        function shapeRegistroValido() {
          return request.resource.data.acaoRef is string
            && request.resource.data.acaoRef.size() > 0
            && request.resource.data.pilar in ['fisico', 'mental', 'espiritual']
            && request.resource.data.quantidade is number
            && request.resource.data.quantidade * 0.0 == 0.0
            && request.resource.data.quantidade > 0
            && request.resource.data.unidade is string
            && request.resource.data.data is timestamp
            && request.resource.data.origem in ['manual', 'assessoria']
            && (('clubeId' in request.resource.data)
                  == ('desafioId' in request.resource.data))
            && (!('clubeId' in request.resource.data)
                || (request.resource.data.clubeId is string
                    && request.resource.data.clubeId.size() > 0
                    && request.resource.data.desafioId is string
                    && request.resource.data.desafioId.size() > 0))
            && !request.resource.data.keys().hasAny(['pontos']);
        }

        allow read: if (isSignedIn() && request.auth.uid == atletaId)
                    || isPlatformAdmin();
        allow create, update: if isSignedIn()
                              && request.auth.uid == atletaId
                              && shapeRegistroValido();
        allow delete: if isSignedIn() && request.auth.uid == atletaId;
      }
    }

    match /catalogoAcoes/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if isPlatformAdmin();
    }

    // ── `profissionais/{profId}` — tenant-scoped via claim ────────────────
    match /profissionais/{profId} {
      allow read: if (isSignedIn() && request.auth.uid == profId)
                  || (isSignedIn() && isTenantMember(resource.data.tenantId))
                  || isPlatformAdmin();
      allow write: if isPlatformAdmin();

      // `dashboard/{docId}` — agregado ∑ do painel do profissional
      // (E02 · S600-T2: KPIs + alertas em `dashboard/current`).
      //
      // ESCRITA: NUNCA pelo cliente — o doc é mantido exclusivamente pela
      // Cloud Function (Admin SDK bypassa Rules). Qualquer write de cliente
      // é fraude de KPI; negado até para platform_admin (que escreve, se
      // precisar, via Admin SDK — nunca pelo SDK de cliente).
      //
      // LEITURA: só o PRÓPRIO profissional (uid == profId) e platform_admin
      // (visão macro). Staff do MESMO tenant não lê dashboard alheio — o
      // agregado é do indivíduo, não do tenant; o painel consome via
      // callable `getOverview`, a leitura direta fica para debug/fallback.
      match /dashboard/{docId} {
        allow read: if (isSignedIn() && request.auth.uid == profId)
                    || isPlatformAdmin();
        allow write: if false;
      }

      // `analyticsSnapshots/{dia}` — histórico DIÁRIO IMUTÁVEL de KPIs
      // (E11 · S821-T1a · Onda 2 T2-L1). Cópia fiel de `dashboard/current`
      // persistida pelo cron `coletaDiaria` (03:05 — ADR-015); docId =
      // YYYY-MM-DD. SEM `alerts` (UI transitória fica fora do histórico).
      //
      // ESCRITA: NUNCA pelo cliente (nem platform_admin via client SDK) —
      // só a Function escreve (Admin SDK bypassa Rules). Sem write de
      // cliente, o PASSADO é imutável por construção: a coleta grava só o
      // doc do dia pedido e o rerun substitui o MESMO dia (nunca anterior).
      //
      // LEITURA: só o PRÓPRIO profissional (uid == profId) e platform_admin
      // — mesma taxonomia do `dashboard` (o histórico é do indivíduo, não
      // do tenant; staff não lê série alheia).
      match /analyticsSnapshots/{dia} {
        allow read: if (isSignedIn() && request.auth.uid == profId)
                    || isPlatformAdmin();
        allow write: if false;
      }

      // `marcas/{marcaId}` — registro REUTILIZÁVEL de patrocinador
      // (R9-E · S-R9-12 · RN-171 — seed do E10-S811).
      //
      // OWNER-ONLY (decisão do épico E10): a marca é ativo comercial do
      // PRÓPRIO profissional — nem staff do mesmo tenant lê a lista alheia
      // (valores de patrocínio são dado sensível de negociação); nem
      // platform_admin via client SDK escreve (postura pós-19c8afe).
      //
      // SHAPE (RN-123 — espelho de validarMarcaInput do core): modelo
      // financeiro exige valorAnual > 0 cent-exato; permuta exige
      // contrapartida ≥ 20 chars; URLs http(s) com teto; status no enum.
      match /marcas/{marcaId} {

        function shapeMarcaValida() {
          return request.resource.data.nome is string
            && request.resource.data.nome.size() >= 1
            && request.resource.data.nome.size() <= 80
            && request.resource.data.modeloComercial in ['financeiro', 'permuta']
            && (request.resource.data.modeloComercial != 'financeiro'
                || (request.resource.data.get('valorAnual', 0) is number
                    && moneyCentExato(request.resource.data.get('valorAnual', 0))
                    && request.resource.data.get('valorAnual', 0) > 0))
            && (request.resource.data.modeloComercial != 'permuta'
                || (request.resource.data.get('contrapartida', '') is string
                    && request.resource.data.get('contrapartida', '').size() >= 20
                    && request.resource.data.get('contrapartida', '').size() <= 2000))
            && (!('logoUrl' in request.resource.data)
                || (request.resource.data.logoUrl is string
                    && request.resource.data.logoUrl.size() <= 2048
                    && request.resource.data.logoUrl.matches('https?://.*')))
            && (!('contratoUrl' in request.resource.data)
                || (request.resource.data.contratoUrl is string
                    && request.resource.data.contratoUrl.size() <= 2048
                    && request.resource.data.contratoUrl.matches('https?://.*')))
            && request.resource.data.get('status', 'ativa') in ['ativa', 'inativa'];
        }

        allow read: if isSignedIn() && request.auth.uid == profId;
        allow create, update: if isSignedIn()
                              && request.auth.uid == profId
                              && shapeMarcaValida();
        allow delete: if isSignedIn() && request.auth.uid == profId;
      }
    }

    // ── `rateLimits/{chave}` — contadores de rate-limit (LEELA-R2) ───────
    // Escrita/leitura EXCLUSIVAS de Function (Admin SDK — consumirRateLimit
    // em functions/src/shared/rateLimit.ts). Chave = hash SHA-256 truncado
    // de origem/alvo (nunca IP em claro — LGPD). SEM match DE PROPÓSITO:
    // cai no deny-by-default abaixo. NÃO abrir para client SDK — ler os
    // contadores daria oráculo de janela ao atacante; escrever permitiria
    // zerar o próprio limite.

    // ── `cobrancasPixAtivas/{uid__eventoId__hashCarrinho}` — trava PIX ───
    // (LEELA-S1209-PIXBE-T2 · RN-157). Sentinela de chave determinística que
    // dá às requisições concorrentes de cobrança um documento em comum para
    // o Firestore serializar — leitura/escrita EXCLUSIVAS de Function (Admin
    // SDK, createInscricaoCharge → travaCobrancaPix.ts). SEM match DE
    // PROPÓSITO: cai no deny-by-default abaixo. NÃO abrir para client SDK —
    // ler daria a um sondador o mapa das cobranças abertas de terceiros;
    // escrever permitiria forjar ou derrubar a própria trava e abrir a
    // segunda cobrança viva que ela existe para impedir.

    // ── `carrinhos/{uid__eventoId}` (+ `/ciclos/{n}`) — prazo do carrinho ─
    // (LEELA-PIX-CARRINHO-T2/T3 · RN-158). O relógio de 15 minutos da
    // ABERTURA até a CONCLUSÃO da compra, e o registro durável por ciclo que
    // a fase 2 (visibilidade de carrinhos abandonados) vai agregar. Leitura/
    // escrita EXCLUSIVAS de Function (Admin SDK — cotarInscricaoCheckout
    // abre, createInscricaoCharge conclui, expirarCarrinhosAbandonados
    // carimba). SEM match DE PROPÓSITO: cai no deny-by-default abaixo. NÃO
    // abrir para client SDK — escrever deixaria o comprador reabrir o
    // próprio prazo (o timer viraria enfeite) e ler daria a um sondador o
    // mapa dos carrinhos abertos de terceiros.

    // ── Bloqueia qualquer coleção não modelada acima ─────────────────────
    // Deny-by-default — não inverta sem rule explícita e testada.
    match /{document=**} {
      allow read, write: if false;
    }

  }
}
