# functions/.env.example — TEMPLATE dos segredos das Functions do LEELA.
# Este arquivo É versionado (documentação). O real fica em functions/.env (gitignored).
# Copie para functions/.env e preencha os valores localmente.

# ── Asaas (gateway de pagamento — D2) ───────────────────────────────────────
# Chave do ambiente SANDBOX/homologação (prefixo "$aact_hmlg_..."). Usada para
# construir e testar o AsaasProvider contra o sandbox, SEM ativar pagamento real.
ASAAS_SANDBOX_API_KEY=

# Chave de PRODUÇÃO / ativação real (prefixo "$aact_prod_..."). Só definir quando
# o AsaasProvider estiver construído e aprovado — o fail-safe (selectProvider.ts)
# LANÇA se esta var estiver presente sem o adapter. Ativação = troca deliberada.
ASAAS_API_KEY=

# ── QR / check-in (já existente — operacional) ──────────────────────────────
# Chaves HMAC do token de QR (check-in fail-closed sem elas). Ver FABLE-C-T1.
QR_TOKEN_KEYS=
QR_TOKEN_KID_ATIVO=
