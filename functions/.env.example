# functions/.env.example — TEMPLATE dos segredos das Functions do LEELA.
# Este arquivo É versionado (documentação). O real fica em functions/.env (gitignored).
# Copie para functions/.env e preencha os valores localmente.

# ── Asaas (gateway de pagamento — D2) ───────────────────────────────────────
#
# REGRA DE OURO (LEELA-DEBT-T6): a var diz o AMBIENTE, e o prefixo da chave tem
# de concordar com ela. `$aact_prod_...` é conta real; `$aact_hmlg_...` é
# homologação. Chave de teste dormindo num slot chamado PROD (ou o contrário) é
# a classe de erro que faz alguém cobrar dinheiro de verdade acreditando estar
# em teste — foi o que aconteceu na rodada R6, e o conserto foi mover o valor,
# não renomear o slot.
#
# ASAAS_API_KEY: a ÚNICA var que o código lê (selectProvider.ts) para ATIVAR o
# gateway real no checkout. Deixe VAZIA até a ativação ser deliberada e
# revisada — o fail-safe lança se ela estiver presente sem adapter, e
# apontá-la p/ produção faria a suíte criar cobranças reais.
ASAAS_API_KEY=

# Chave de PRODUÇÃO isolada, só para teste opt-in READ-ONLY (ex.: GET /myAccount)
# — jamais criação de cobrança/cliente. A suíte de checkout NUNCA lê esta var.
# Nenhum código do repositório lê esta var hoje: ela é um COFRE, não uma porta.
# Só aceita chave com prefixo "$aact_prod_".
ASAAS_PROD_API_KEY=

# Chave do ambiente SANDBOX/homologação — só aceita prefixo "$aact_hmlg_". É a
# que destrava o teste ponta-a-ponta de cobrança sem risco de dinheiro real
# (copie o valor daqui para ASAAS_API_KEY quando for ativar a sandbox).
ASAAS_SANDBOX_API_KEY=

# ── QR / check-in (já existente — operacional) ──────────────────────────────
# Chaves HMAC do token de QR (check-in fail-closed sem elas). Ver FABLE-C-T1.
QR_TOKEN_KEYS=
QR_TOKEN_KID_ATIVO=

# ── CRM (E19) — hardening A3 (COMF2) ──
# Pepper do HMAC da chave de cliente do CRM (fail-closed — obrigatorio).
# Producao: Secret Manager. Dev/emulator: qualquer valor de teste.
CRM_ID_PEPPER=
