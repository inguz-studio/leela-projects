    "size": {
      "xs": "0.625rem",
      "xs-plus": "0.6875rem",
      "sm": "0.75rem",
      "sm-plus": "0.8125rem",
      "base": "0.875rem",
      "base-plus": "0.9375rem",
      "md": "1rem",
