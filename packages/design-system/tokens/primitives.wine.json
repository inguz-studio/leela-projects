      "xl-plus": "1.75rem",
      "2xl": "2rem",
      "3xl": "2.5rem",
      "4xl": "3rem"
    },
    "weight": {
      "regular": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700",
      "extrabold": "800"
    },
    "lineHeight": {
      "tight": "1.2",
      "base": "1.5",
      "loose": "1.8"
    }
  },
  "spacing": {
    "$description": "Mesma escala do tema brasa (paridade de vars): meio-passos 0-5/1-5/2-5/3-5 (2/6/10/14px) vindos do mockup be-hero. Nunca px cru em componente.",
    "0": "0px",
    "0-5": "2px",
    "1": "4px",
    "1-5": "6px",
    "2": "8px",
    "2-5": "10px",
    "3": "12px",
    "3-5": "14px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px",
    "20": "80px",
    "24": "96px"
  },
  "radius": {
    "none": "0px",
    "xs": "4px",
    "sm": "6px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px",
    "pill": "9999px"
  },
  "gradient": {
    "$description": "Equivalentes wine dos gradientes de modalidade (paleta propria, mesma anatomia 135deg). Duplas escolhidas para icone branco >=3:1 na regiao do icone: virtual usa success.600 (400 reprova) e crossfit warning.600 (500 reprova).",
    "corrida":  "linear-gradient(135deg, #E85662, #4A0A12)",
    "ciclismo": "linear-gradient(135deg, #C42C3A, #230409)",
    "yoga":     "linear-gradient(135deg, #ED3585, #4E0928)",
    "virtual":  "linear-gradient(135deg, #16A34A, #14532D)",
    "crossfit": "linear-gradient(135deg, #D97706, #78350F)"
  },
  "elevation": {
    "0": "none",
    "1": "0 1px 3px 0 rgba(0,0,0,0.1), 0 1px 2px -1px rgba(0,0,0,0.1)",
    "2": "0 4px 6px -1px rgba(0,0,0,0.15), 0 2px 4px -2px rgba(0,0,0,0.15)",
    "3": "0 10px 15px -3px rgba(0,0,0,0.2), 0 4px 6px -4px rgba(0,0,0,0.2)",
    "brand": "0 0 20px 0 rgba(122,21,32,0.5)"
  },
  "motion": {
    "duration": {
      "fast": "150ms",
      "normal": "240ms",
      "slow": "400ms"
    },
    "easing": {
      "default": "cubic-bezier(0.2, 0.8, 0.2, 1)",
      "enter": "cubic-bezier(0.3, 0.7, 0, 1)",
      "exit": "cubic-bezier(0.3, 0.7, 0, 1)"
    }
  },
  "icon": {
    "size": "24px",
    "stroke": "1.75"
  }
}
