{
  "layout": {
    "$description": "Moldura da pagina do mockup be-hero (`.main` 32px 40px 48px, grid gap 24) e ritmos internos: colunas/section 16, section-head margin 14, listas de rows 8. Toolbar fecha com padding-bottom 16 sobre hairline.",
    "page-pt":         "{spacing.8}",
    "page-px":         "{spacing.10}",
    "page-pb":         "{spacing.12}",
    "main-gap":        "{spacing.6}",
    "stack-gap":       "{spacing.4}",
    "section-gap":     "{spacing.4}",
    "section-head-mb": "{spacing.3-5}",
    "grid-gap":        "{spacing.4}",
    "list-gap":        "{spacing.2}",
    "toolbar-pb":      "{spacing.4}"
  },
  "btn": {
    "$description": "Alturas 32/36/48 e px 12/14/20 do mockup `.btn`; radius sm 6.",
    "height-sm":     "32px",
    "height-md":     "36px",
    "height-lg":     "48px",
    "radius":        "{radius.sm}",
    "font-size-sm":  "{font.size.sm}",
    "font-size-md":  "{font.size.base}",
    "font-size-lg":  "{font.size.md}",
    "font-weight":   "600",
    "px-sm":         "{spacing.3}",
    "px-md":         "{spacing.3-5}",
    "px-lg":         "{spacing.5}",
    "focus-ring":    "2px"
  },
  "input": {
    "height":        "40px",
    "radius":        "{radius.sm}",
    "font-size":     "{font.size.md}",
    "px":            "{spacing.4}",
    "border-width":  "1px"
  },
  "badge": {
    "height":        "22px",
    "radius":        "{radius.xs}",
    "font-size":     "{font.size.sm}",
    "font-weight":   "600",
    "px":            "{spacing.2}"
  },
  "chip": {
    "height":        "32px",
    "radius":        "{radius.pill}",
    "font-size":     "{font.size.base}",
    "px":            "{spacing.3}"
  },
  "avatar": {
    "size-sm":       "32px",
    "size-md":       "40px",
    "size-lg":       "48px",
    "radius":        "{radius.pill}"
  },
  "divider": {
    "thickness":     "1px"
  },
  "header": {
    "height":        "96px"
  },
  "sidebar": {
    "$description": "Métricas exatas do mockup be-hero: .brand 24/20/20 (mark 22 italic, sub 11 uppercase mt 6) · .nav 16x12 gap 2 · .nav-label 10px/.08em pad 12/12/8 · .nav-item 10x12 gap 12 texto 14 ícone 20 · .nav-badge 10px/700 pad 2x6 · .sidebar-footer 14x16 gap 12 (nome 13, link 11).",
    "width":         "240px",
    "collapsed-width": "64px",
    "active-bar":    "2px",
    "active-bar-inset": "6px",
    "brand-pt":      "{spacing.6}",
    "brand-px":      "{spacing.5}",
    "brand-pb":      "{spacing.5}",
    "brand-mark-size": "22px",
    "brand-mark-spacing": "0.02em",
    "brand-sub-size": "{font.size.xs-plus}",
    "brand-sub-mt":  "{spacing.1-5}",
    "brand-sub-spacing": "0.04em",
    "nav-py":        "{spacing.4}",
    "nav-px":        "{spacing.3}",
    "nav-gap":       "{spacing.0-5}",
    "label-pt":      "{spacing.3}",
    "label-pb":      "{spacing.2}",
    "label-px":      "{spacing.3}",
    "label-size":    "{font.size.xs}",
    "label-spacing": "0.08em",
    "item-py":       "{spacing.2-5}",
    "item-px":       "{spacing.3}",
    "item-gap":      "{spacing.3}",
    "item-size":     "{font.size.base}",
    "icon-size":     "20px",
    "badge-px":      "{spacing.1-5}",
    "badge-py":      "{spacing.0-5}",
    "badge-size":    "{font.size.xs}",
    "badge-radius":  "{radius.xs}",
    "badge-spacing": "0.04em",
    "footer-py":     "{spacing.3-5}",
    "footer-px":     "{spacing.4}",
    "footer-gap":    "{spacing.3}",
    "footer-name-size": "{font.size.sm-plus}",
    "footer-link-size": "{font.size.xs-plus}"
  },
  "subnav": {
    "height":        "48px",
    "underline":     "2px",
    "px":            "{spacing.10}",
    "pill-height":   "20px",
    "pill-min-width": "28px",
    "pill-radius":   "10px",
    "pill-font-size": "11px"
  },
  "table": {
    "$description": "Densidade do mockup `.table`: celula 14x16 (compact 10x16 e coberto por row-height ~47), header py 12, corpo 13px, header 10px uppercase 0.08em.",
    "row-height":    "47px",
    "cell-px":       "{spacing.4}",
    "cell-py":       "{spacing.3-5}",
    "header-py":     "{spacing.3}",
    "font-size":     "{font.size.sm-plus}",
    "header-font-size": "{font.size.xs}",
    "header-spacing": "0.08em"
  },
  "popover": {
    "min-width":     "160px"
  },
  "modal": {
    "width-sm":      "480px",
    "width-md":      "560px",
    "width-lg":      "640px",
    "overlay-bg":    "rgba(0,0,0,0.6)",
    "overlay-blur":  "4px"
  },
  "toast": {
    "width":         "360px",
    "border-left":   "3px"
  },
  "card": {
    "radius":        "{radius.lg}",
    "critical-border": "3px"
  },
  "stepper": {
    "step-size":     "32px"
  },
  "skeleton": {
    "radius":        "{radius.xs}"
  }
}
