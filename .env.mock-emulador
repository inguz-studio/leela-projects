# =============================================================================
# .env.mock-emulador (raiz — envDir do vite.config.ts do painel)
#
# Modo de build do painel para o MOCK LOCAL do dono (lane MOCK-CAMPECHE):
# painel apontado ao Firebase EMULATOR, nunca ao projeto real.
#
# Uso:  cd apps/painel && npx vite build --mode mock-emulador
#       (o `scripts/mock-campeche.sh up` faz isso e serve o resultado em :4602)
#
# ⛔ ZERO PRODUÇÃO: este arquivo NÃO carrega nenhuma credencial do projeto
# `leela-hub`. Só `VITE_USE_EMULATOR=true` + as portas do Emulator local. O
# `.env.leela-hub` (build de produção) segue existindo separado e intocado —
# os dois nunca se cruzam, que é o ponto: dinheiro de mentira jamais alcança
# um painel de verdade.
#
# COMMITADO de propósito (exceção explícita no .gitignore, mesmo critério do
# `.env.leela-hub`): não há segredo aqui — são endereços de loopback. O valor
# de commitar é o comando de 1 linha continuar funcionando depois de um
# reboot, na mão do dono, sem ninguém ter de reconstruir este arquivo de
# memória.
# =============================================================================

# Emulator Suite em BLOCO DE PORTAS PRÓPRIO (firebase.mockcampeche.json).
#
# Por que não as 8180/9198 do preview local: aquele bloco é do `preview.sh` e
# estava OCUPADO por outra lane rodando do worktree `leela-wt-responsivo`.
# Derrubar o emulador de uma lane vizinha é destruir trabalho alheio em
# silêncio — o mock ganhou bloco próprio e passou a conviver com todo mundo.
VITE_USE_EMULATOR=true
VITE_EMULATOR_HOST=127.0.0.1
VITE_EMULATOR_FIRESTORE_PORT=8280
VITE_EMULATOR_AUTH_PORT=9298
VITE_EMULATOR_FUNCTIONS_PORT=5301
VITE_EMULATOR_STORAGE_PORT=9399

# O painel não tem tela de login (a autenticação real é de outra superfície):
# o auto-login do preview é o que dá sessão ao navegador. A identidade é
# escolhida por `?preview=` na URL — ver preview-autologin.ts e o handoff.
VITE_PREVIEW_AUTOLOGIN=true

# Base pública usada para MONTAR links (afiliado/assessoria). Aponta para o
# próprio mock: link de mentira não deve levar ninguém ao site real.
VITE_LEELA_URL=http://127.0.0.1:4602
