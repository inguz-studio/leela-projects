# =============================================================================
# apps/painel/.env.leela-hub — build do painel apontado ao projeto REAL
#
# Uso:  vite build --mode leela-hub   (lane DEPLOY-PREVIEW; deploy via
#       firebase.prod.json → canal de preview do Hosting)
#
# COMMITADO de propósito: config web do Firebase NÃO é segredo (é entregue a
# qualquer navegador que abre o app). Segurança vem das Security Rules + Auth.
# O build canônico (`npm run build`, sem --mode) segue fail-closed sem config.
# =============================================================================
VITE_USE_EMULATOR=false
VITE_FIREBASE_API_KEY=AIzaSyAEfCA8HuccfEtTFAYONaeMK4cWi95MMb4
VITE_FIREBASE_AUTH_DOMAIN=leela-hub.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=leela-hub
VITE_FIREBASE_STORAGE_BUCKET=leela-hub.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=76126035891
VITE_FIREBASE_APP_ID=1:76126035891:web:d858cdf41199c7103575c6
