# =============================================================================
# apps/landing/.env.leela-hub — build da LANDING apontado ao projeto REAL
# (alias `prod` = leela-hub). Lane LANDING-PREVIEW.
#
# Uso:  node apps/landing/scripts/deploy-leela-hub.mjs
#       (o script carrega ESTE arquivo no ambiente e chama o firebase deploy;
#       o Next não tem `--mode` como o Vite, então o carregamento é explícito)
#
# COMMITADO de propósito, mesma justificativa da DEPLOY-PREVIEW: a config web
# do Firebase NÃO é segredo — ela é entregue a qualquer navegador que abre o
# app. A segurança vem das Security Rules + Auth. NENHUMA chave de servidor
# (Asaas, Brevo, keyring do QR) entra aqui; essas vivem no Secret Manager e só
# as Functions as enxergam.
#
# O `next build` canônico (sem este arquivo) segue fail-closed: sem config
# completa o `configProducao()` de lib/leelaClient.ts devolve undefined e o
# cliente cai no projeto demo do Emulator.
# =============================================================================

# Emulador DESLIGADO. O seed de produção já foi re-datado (+135d pela
# DEPLOY-PREVIEW), então nada de LEELA_CLOCK aqui: os eventos estão vigentes
# no relógio real.
NEXT_PUBLIC_USE_EMULATOR=false

# Config web pública — a MESMA app web `painel` registrada pela DEPLOY-PREVIEW.
# Reuso deliberado: um appId a menos para rotacionar e para divergir. Se App
# Check entrar em cena por app, aí sim vale registrar uma app web própria.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyAEfCA8HuccfEtTFAYONaeMK4cWi95MMb4
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=leela-hub.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=leela-hub
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=leela-hub.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=76126035891
NEXT_PUBLIC_FIREBASE_APP_ID=1:76126035891:web:d858cdf41199c7103575c6

# Origem canônica da superfície pública (lib/seo.ts → baseUrl()). Alimenta
# canonical, Open Graph, JSON-LD, robots.txt e sitemap.xml. Item 12 do painel
# (domínio próprio) ainda é decisão do dono — quando ele decidir, muda AQUI e
# em nenhum outro lugar.
NEXT_PUBLIC_LEELA_URL=https://leela-landing.web.app

# Painel do organizador (S1213-T1 · P10) — destino do "Entrar" e do "Criar
# conta de organizador" no header/footer público. A landing e o painel são
# deploys distintos; sem esta env o link cairia no default do código
# (lib/painel.ts). Domínio próprio do painel muda AQUI.
NEXT_PUBLIC_PAINEL_URL=https://leela-hub.web.app
