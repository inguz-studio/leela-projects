{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022"],
    "moduleResolution": "bundler",
    "noEmit": true,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "typeRoots": ["./node_modules/@types"],
    "paths": {
      "@leela/core": ["../../packages/core/src/index.ts"],
      "@leela/design-system": ["../../packages/design-system/src/index.ts"],
      "@leela/api-client": ["../../packages/api-client/src/index.ts"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.d.ts",
    "expo-env.d.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
